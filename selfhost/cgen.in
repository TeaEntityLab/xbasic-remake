      assign rest:string = string("")
    else
      assign param:string = call LEFT$(symbol(rest:string), arith(symbol(commaPos:integer) - integer(1)))
      assign rest:string = call MID$(symbol(rest:string), arith(symbol(commaPos:integer) + integer(1)), arith(call LEN(symbol(rest:string)) - symbol(commaPos:integer)))
      if and(compare(call LEN(symbol(rest:string)) > integer(0)) compare(call ASC(call MID$(symbol(rest:string), integer(1), integer(1))) = integer(32)))
        assign rest:string = call MID$(symbol(rest:string), integer(2), arith(call LEN(symbol(rest:string)) - integer(1)))
      end if
    end if
    assign param:string = call trim_spaces(symbol(param:string))
    if compare(call LEN(symbol(param:string)) > integer(0))
      assign colonPos:integer = call INSTR(symbol(param:string), string(":"))
      if compare(symbol(colonPos:integer) > integer(0))
        assign pName:string = call LEFT$(symbol(param:string), arith(symbol(colonPos:integer) - integer(1)))
        assign pType:string = call MID$(symbol(param:string), arith(symbol(colonPos:integer) + integer(1)), arith(call LEN(symbol(param:string)) - symbol(colonPos:integer)))
      else
        assign pName:string = symbol(param:string)
        assign pType:string = string("integer")
      end if
      if compare(call LEN(symbol(result:string)) > integer(0))
        assign result:string = arith(symbol(result:string) + string(", "))
      end if
      assign result:string = arith(arith(arith(symbol(result:string) + call c_type(symbol(pType:string))) + string(" ")) + call c_var_name(symbol(pName:string), symbol(pType:string)))
    end if
  wend
  assign emit_params:string = symbol(result:string)
end function
function emit_stmt(s:string) -> string
  dim rest:string
  dim spacePos:integer
  dim varName:string
  dim varType:string
  dim colonPos:integer
  dim bracketPos:integer
  dim arrSize:string
  dim cExpr:string
  dim c2:string
  dim etype:string
  dim tmp:string
  dim right:string
  dim start:string
  dim end:string
  dim fn:string
  dim args:string
  dim parenPos:integer
  dim pName:string
  dim pType:string
  dim hashPos:integer
  dim eqPos:integer
  dim expr:string
  if compare(call LEFT$(symbol(s:string), integer(8)) = string("function"))
    assign emit_stmt:string = string("")
