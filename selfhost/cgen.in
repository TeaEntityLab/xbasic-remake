        if and(compare(arith(symbol(q:integer) + integer(1)) <= call LEN(symbol(s:string))) compare(call ASC(call MID$(symbol(s:string), arith(symbol(q:integer) + integer(1)), integer(1))) = integer(41)))
          assign first_expr:string = call LEFT$(symbol(s:string), arith(symbol(q:integer) + integer(1)))
