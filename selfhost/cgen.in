function trim_spaces(s:string) -> string
  dim i:integer
  dim j:integer
  assign i:integer = integer(1)
  while compare(symbol(i:integer) <= call LEN(symbol(s:string)))
    if compare(call ASC(call MID$(symbol(s:string), symbol(i:integer), integer(1))) = integer(32))
      assign i:integer = arith(symbol(i:integer) + integer(1))
    else
      exit_loop
    end if
  wend
  assign j:integer = call LEN(symbol(s:string))
  while compare(symbol(j:integer) >= symbol(i:integer))
    if compare(call ASC(call MID$(symbol(s:string), symbol(j:integer), integer(1))) = integer(32))
      assign j:integer = arith(symbol(j:integer) - integer(1))
