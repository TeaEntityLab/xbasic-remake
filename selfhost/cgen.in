  end if
  if compare(symbol(s:string) = string("end function"))
    assign emit_stmt:string = string("}")
    return symbol(emit_stmt:string)
  end if
  if compare(call LEFT$(symbol(s:string), integer(7)) = string("version"))
    assign emit_stmt:string = string("")
    return symbol(emit_stmt:string)
  end if
  if compare(call LEFT$(symbol(s:string), integer(5)) = string("const"))
    assign emit_stmt:string = string("")
    return symbol(emit_stmt:string)
  end if
  if compare(call LEFT$(symbol(s:string), integer(7)) = string("shared "))
    assign rest:string = call MID$(symbol(s:string), integer(8), arith(call LEN(symbol(s:string)) - integer(7)))
    assign hashPos:integer = call INSTR(symbol(rest:string), string("#"))
    if compare(symbol(hashPos:integer) > integer(0))
      assign rest:string = call MID$(symbol(rest:string), arith(symbol(hashPos:integer) + integer(2)), arith(arith(call LEN(symbol(rest:string)) - symbol(hashPos:integer)) - integer(1)))
    end if
    assign colonPos:integer = call INSTR(symbol(rest:string), string(":"))
    if compare(symbol(colonPos:integer) > integer(0))
      assign varName:string = call LEFT$(symbol(rest:string), arith(symbol(colonPos:integer) - integer(1)))
      assign eqPos:integer = call INSTR(symbol(rest:string), string("= "))
      if compare(symbol(eqPos:integer) > integer(0))
