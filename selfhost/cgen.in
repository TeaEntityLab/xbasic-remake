    assign ch:integer = call ASC(call MID$(symbol(s:string), symbol(p:integer), integer(1)))
    if compare(symbol(ch:integer) = integer(34))
      assign inQuote:integer = arith(integer(1) - symbol(inQuote:integer))
    else
      if compare(symbol(inQuote:integer) = integer(0))
        if compare(symbol(ch:integer) = integer(40))
          assign depth:integer = arith(symbol(depth:integer) + integer(1))
        else
          if compare(symbol(ch:integer) = integer(41))
            assign depth:integer = arith(symbol(depth:integer) - integer(1))
          end if
        end if
      end if
    end if
    assign p:integer = arith(symbol(p:integer) + integer(1))
  wend
  assign first_expr:string = call LEFT$(symbol(s:string), arith(symbol(p:integer) - integer(1)))
end function
function after_first(s:string) -> string
  dim fe:string
