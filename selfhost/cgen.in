      exit_loop
    end if
  wend
  if compare(symbol(j:integer) < symbol(i:integer))
    assign trim_spaces:string = string("")
  else
    assign trim_spaces:string = call MID$(symbol(s:string), symbol(i:integer), arith(arith(symbol(j:integer) - symbol(i:integer)) + integer(1)))
  end if
