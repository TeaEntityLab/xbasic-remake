function emit_args(a:string) -> string
  dim i:integer
  dim ch:integer
  dim depth:integer
  dim start:integer
  dim parts:string
  dim arg:string
  if compare(call LEN(symbol(a:string)) = integer(0))
    assign emit_args:string = string("")
    return symbol(emit_args:string)
  end if
  assign parts:string = string("")
  assign i:integer = integer(1)
  assign start:integer = integer(1)
  assign depth:integer = integer(0)
  while compare(symbol(i:integer) <= call LEN(symbol(a:string)))
    assign ch:integer = call ASC(call MID$(symbol(a:string), symbol(i:integer), integer(1)))
    if compare(symbol(ch:integer) = integer(40))
      assign depth:integer = arith(symbol(depth:integer) + integer(1))
    else
      if compare(symbol(ch:integer) = integer(41))
        assign depth:integer = arith(symbol(depth:integer) - integer(1))
      else
        if and(compare(symbol(ch:integer) = integer(44)) compare(symbol(depth:integer) = integer(0)))
          assign arg:string = call MID$(symbol(a:string), symbol(start:integer), arith(symbol(i:integer) - symbol(start:integer)))
          assign arg:string = call trim_spaces(symbol(arg:string))
          if compare(call LEN(symbol(parts:string)) > integer(0))
            assign parts:string = arith(symbol(parts:string) + string(", "))
          end if
          assign parts:string = arith(symbol(parts:string) + call emit_expr(symbol(arg:string)))
          assign start:integer = arith(symbol(i:integer) + integer(1))
        end if
      end if
    end if
    assign i:integer = arith(symbol(i:integer) + integer(1))
  wend
  if compare(symbol(start:integer) <= call LEN(symbol(a:string)))
    assign arg:string = call MID$(symbol(a:string), symbol(start:integer), arith(arith(call LEN(symbol(a:string)) - symbol(start:integer)) + integer(1)))
    assign arg:string = call trim_spaces(symbol(arg:string))
    if compare(call LEN(symbol(parts:string)) > integer(0))
      assign parts:string = arith(symbol(parts:string) + string(", "))
    end if
    assign parts:string = arith(symbol(parts:string) + call emit_expr(symbol(arg:string)))
  end if
  assign emit_args:string = symbol(parts:string)
end function
function emit_params(params:string) -> string
  dim result:string
  dim rest:string
  dim commaPos:integer
  dim param:string
  dim colonPos:integer
  dim pName:string
  dim pType:string
  assign result:string = string("")
  assign rest:string = symbol(params:string)
  while compare(call LEN(symbol(rest:string)) > integer(0))
    assign commaPos:integer = call INSTR(symbol(rest:string), string(","))
    if compare(symbol(commaPos:integer) = integer(0))
