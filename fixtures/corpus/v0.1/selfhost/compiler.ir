function strip_suffix(name:string) -> string
  dim lastChar:integer
  assign lastChar:integer = call ASC(call RIGHT$(symbol(name:string), integer(1)))
  if compare(symbol(lastChar:integer) = integer(36))
    shared ##suffixType:string = string("string")
    assign strip_suffix:string = call LEFT$(symbol(name:string), arith(call LEN(symbol(name:string)) - integer(1)))
  else
    if compare(symbol(lastChar:integer) = integer(37))
      shared ##suffixType:string = string("integer")
      assign strip_suffix:string = call LEFT$(symbol(name:string), arith(call LEN(symbol(name:string)) - integer(1)))
    else
      if compare(symbol(lastChar:integer) = integer(33))
        shared ##suffixType:string = string("float")
        assign strip_suffix:string = call LEFT$(symbol(name:string), arith(call LEN(symbol(name:string)) - integer(1)))
      else
        if compare(symbol(lastChar:integer) = integer(35))
          shared ##suffixType:string = string("float")
          assign strip_suffix:string = call LEFT$(symbol(name:string), arith(call LEN(symbol(name:string)) - integer(1)))
        else
          shared ##suffixType:string = string("integer")
          assign strip_suffix:string = symbol(name:string)
        end if
      end if
    end if
  end if
end function
