version 0.0001
const $$XBSysLinux:integer = integer(1)
const $$XBSysWin32:integer = integer(2)
function Main
  dim utilityName:string
  dim utilityVersion:float
  assign utilityName:string = string("xut")
  assign utilityVersion:float = float(0.0001)
  print symbol(utilityName:string)
  print symbol(utilityVersion:float)
  print constant($$XBSysLinux:integer = integer(1))
  print constant($$XBSysWin32:integer = integer(2))
end function
