version 0.0001
const $$XBSysLinux:integer = integer(1)
const $$XBSysWin32:integer = integer(2)
function PlatformName() -> string
  if constant($$XBSysLinux:integer = integer(1))
    return string("linux")
  end if
  return string("unknown")
end function
function Main() -> integer
  dim utilityName:string
  dim utilityVersion:float
  assign utilityName:string = string("xut")
  assign utilityVersion:float = float(0.0001)
  shared ##XBSystem:integer = constant($$XBSysLinux:integer = integer(1))
  print symbol(utilityName:string)
  print symbol(utilityVersion:float)
  print constant($$XBSysLinux:integer = integer(1))
  print constant($$XBSysWin32:integer = integer(2))
  print shared(##XBSystem:integer)
  if constant($$XBSysLinux:integer = integer(1))
    print string("linux")
  end if
  if compare(shared(##XBSystem:integer) = constant($$XBSysLinux:integer = integer(1)))
    print string("match")
    print arith(constant($$XBSysLinux:integer = integer(1)) + constant($$XBSysWin32:integer = integer(2)))
    print call PlatformName()
  end if
end function
