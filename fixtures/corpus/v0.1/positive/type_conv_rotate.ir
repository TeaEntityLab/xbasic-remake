function Main() -> integer
  print call SLONG(integer(42))
  print call ULONG(integer(42))
  print call GIANT(integer(42))
  print call SBYTE(integer(256))
  print call SSHORT(integer(42))
  print call USHORT(integer(42))
  print call ROTATEL(integer(1), integer(4))
  print call ROTATER(integer(16), integer(4))
  print call ROTATEL(integer(0xFF), integer(8))
  print call ROTATER(integer(0xFF00), integer(8))
end function
