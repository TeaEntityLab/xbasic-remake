version 0.1
function Main() -> integer
  dim a:integer
  dim b:integer
  dim c:integer
  assign a:integer = integer(1)
  assign b:integer = integer(0)
  assign c:integer = and(symbol(a:integer) symbol(b:integer))
  print symbol(c:integer)
  assign c:integer = or(symbol(a:integer) symbol(b:integer))
  print symbol(c:integer)
  assign c:integer = not(symbol(a:integer))
  print symbol(c:integer)
  if and(symbol(a:integer) integer(1))
    print integer(100)
  end if
  if not(symbol(b:integer))
    print integer(200)
  end if
end function
