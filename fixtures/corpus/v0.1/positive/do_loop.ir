version 0.1
function Main() -> integer
  dim i:integer
  dim sum:integer
  assign sum:integer = integer(0)
  assign i:integer = integer(1)
  do while compare(symbol(i:integer) <= integer(10))
    assign sum:integer = arith(symbol(sum:integer) + symbol(i:integer))
    assign i:integer = arith(symbol(i:integer) + integer(1))
  loop
  print symbol(sum:integer)
end function
