version 0.1
function Main() -> integer
  dim a:integer
  dim b:integer
  dim c:integer
  dim x:integer
  dim y:integer
  assign a:integer = integer(1)
  assign b:integer = integer(2)
  assign c:integer = integer(3)
  print symbol(a:integer)
  print symbol(b:integer)
  print symbol(c:integer)
  assign a:integer = arith(symbol(a:integer) + integer(1))
  assign b:integer = arith(symbol(b:integer) + integer(1))
  assign c:integer = arith(symbol(c:integer) + integer(1))
  print symbol(a:integer)
  print symbol(b:integer)
  print symbol(c:integer)
  assign x:integer = integer(10)
  assign y:integer = integer(20)
  swap x:integer y:integer
  print symbol(x:integer)
  print symbol(y:integer)
end function
