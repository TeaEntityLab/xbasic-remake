version 0.1
function Main() -> integer
  print call HEX$(integer(255))
  print call HEX$(integer(255), integer(4))
  print call HEX$(integer(255), integer(8))
  print call HEX$(integer(10), integer(2))
  print call HEXX$(integer(255))
  print call HEXX$(integer(255), integer(4))
  print call HEX$(integer(0xFF), integer(4))
end function
