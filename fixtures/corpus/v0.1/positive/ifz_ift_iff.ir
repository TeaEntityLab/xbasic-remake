version 0.1
function Main() -> integer
  dim x:integer
  dim y:integer
  assign x:integer = integer(5)
  if compare(symbol(x:integer) = integer(0))
    print string("x is zero")
  end if
  if compare(symbol(x:integer) <> integer(0))
    print string("x is nonzero")
  end if
  assign y:integer = integer(0)
  if compare(symbol(y:integer) = integer(0))
    print string("y is false")
  end if
end function
