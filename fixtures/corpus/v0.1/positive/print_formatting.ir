version 0.1
function Main() -> integer
  dim x:integer
  assign x:integer = integer(42)
  print string("x =") ; symbol(x:integer)
  print string("x =") ; symbol(x:integer) ; string("!")
  print string("a") , string("b") , string("c")
  print integer(1) ; integer(2) ; integer(3)
  print string("mixed") ; integer(42) ; string("end")
end function
