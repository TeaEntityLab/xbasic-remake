VERSION "0.1"
PROGRAM "test"
IMPORT "xst"
EXPORT
$$TRUE = 1
EXPORT XBSystem
DECLARE FUNCTION Foo()
DECLARE CFUNCTION Bar()
END EXPORT
INTERNAL FUNCTION Helper()
RETURN 42
END FUNCTION
EXTERNAL FUNCTION Foo()
RETURN Helper()
END FUNCTION
CFUNCTION Dummy()
RETURN 0
END FUNCTION
FUNCTION Main
PRINT Foo()
END FUNCTION
END PROGRAM
