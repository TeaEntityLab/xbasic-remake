TYPE DCB
  XLONG   .DCBlength
  XLONG   .BaudRate
  XLONG   .fModes
  SSHORT  .wReserved
  SSHORT  .XonLim
  SSHORT  .XoffLim
  SBYTE   .ByteSize
  SBYTE   .Parity
  SBYTE   .StopBits
  UBYTE   .XonChar
  UBYTE   .XoffChar
  UBYTE   .ErrorChar
  UBYTE   .EofChar
  UBYTE   .EvtChar
END TYPE
'
TYPE FILETIME
  XLONG   .dwLowDateTime
  XLONG   .dwHighDateTime
END TYPE
'
TYPE SYSTEMTIME
  USHORT  .year
  USHORT  .month
  USHORT  .weekDay
  USHORT  .day
  USHORT  .hour
  USHORT  .minute
  USHORT  .second
  USHORT  .msec
END TYPE
