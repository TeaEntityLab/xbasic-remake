'-------------------------------------------------------------------------------------------------------------
' The following effect the look of the "XuiFile" window displayed when the
' XstFileSelect() or XstFileSelectOpen() functions are called.  The program
' set to "*" will apply to all user programs, but can be set to the name of
' the user program to apply to only that specific program.
'
'	Window  XstFileSelect
'	*         XuiFile           XuiSendMessage (fileSelect, #SetColor, $$Cyan, -1, -1, -1, 0, 0)
'	*         XuiFile           XuiSendMessage (fileSelect, #SetColor, $$Cyan, -1, -1, -1, labelFileName, 0)
'	*         XuiFile           XuiSendMessage (fileSelect, #SetColor, $$Cyan, -1, -1, -1, fileSelect_fileName, 0)
'	*         XuiTextLine       XuiSendMessage (fileSelect_fileName, #SetColor, $$Cyan, -1, -1, -1, textLineArea, 0)
'	*         XuiFile           XuiSendMessage (fileSelect, #SetColor, $$Cyan, -1, -1, -1, labelFilter, 0)
'	*         XuiFile           XuiSendMessage (fileSelect, #SetColor, $$Cyan, -1, -1, -1, fileSelect_filter, 0)
'	*         XuiDropBox        XuiSendMessage (fileSelect_filter, #SetColor, $$Cyan, -1, -1, -1, fileSelect_filter_textLine, 0)
'	*         XuiTextLine       XuiSendMessage (fileSelect_filter_textLine, #SetColor, $$Cyan, -1, -1, -1, textLineArea, 0)
'	*         XuiDropBox        XuiSendMessage (fileSelect_filter, #SetColor, $$Cyan, -1, -1, -1, pressButton, 0)
'
'	Window  fileSelect_FilterPulldown
'	*         XuiPullDown       XuiSendMessage (fileSelect_filter_pulldown, #SetColor, $$Cyan, -1, -1, -1, 0, 0)
'	*         XuiPullDown       XuiSendMessage (fileSelect_filter_pulldown, #SetColor, $$Cyan, -1, -1, -1, textArea, 0)
'	*         XuiFile           XuiSendMessage (fileSelect, #SetColor, $$Cyan, -1, -1, -1, fileSelect_listDirectory, 0)
'	*         XuiList           XuiSendMessage (fileSelect_listDirectory, #SetColor, $$Cyan, -1, -1, -1, listArea, 0)
'	*         XuiList           XuiSendMessage (fileSelect_listDirectory, #SetColor, $$Cyan, -1, -1, -1, scrollH, 0)
'	*         XuiList           XuiSendMessage (fileSelect_listDirectory, #SetColor, $$Cyan, -1, -1, -1, scrollV, 0)
'	*         XuiFile           XuiSendMessage (fileSelect, #SetColor, $$Cyan, -1, -1, -1, fileSelect_listFile, 0)
'	*         XuiList           XuiSendMessage (fileSelect_listFile, #SetColor, $$Cyan, -1, -1, -1, listArea, 0)
