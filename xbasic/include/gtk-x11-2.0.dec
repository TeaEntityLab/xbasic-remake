'#########################
'########  gtkentry
'#########################

TYPE GTKENTRY
  XLONG  .widget
  XLONG  .text
	ULONG .flags1
'  ULONG  .editable
'  ULONG  .visible
'  ULONG  .overwrite_mode
'  ULONG  .in_drag	' Dragging within the selection

  USHORT .text_length	' length in use, in chars
  USHORT .text_max_length

'< private >
  XLONG .text_area
  XLONG .im_context
  XLONG .popup_menu

  XLONG .current_pos
  XLONG .selection_bound

  XLONG .cached_layout

	ULONG .flags2
'  ULONG .cache_includes_preedit
'  ULONG .need_im_reset
'  ULONG .has_frame
'  ULONG .activates_default
'  ULONG .cursor_visible
'  ULONG .in_click               ' Flag so we don't select all when clicking in entry to focus in
'  ULONG .is_cell_renderer
'  ULONG .editing_canceled       ' Only used by GtkCellRendererText
'  ULONG .mouse_cursor_obscured
'  ULONG .select_words
'  ULONG .select_lines
'  ULONG .resolved_dir 						' PangoDirection
'  ULONG .truncate_multiline

  ULONG   .button
  ULONG   .blink_timeout
  ULONG   .recompute_idle
  XLONG    .scroll_offset
  XLONG    .ascent	' font ascent, in pango units
  XLONG    .descent	' font descent, in pango units

  USHORT .text_size	' allocated size, in bytes
  USHORT .n_bytes	' length in use, in bytes

  USHORT .preedit_length	' length of preedit string, in bytes
  USHORT .preedit_cursor	' offset of cursor within preedit string, in chars

  XLONG .dnd_position		' In chars, -1 == no DND cursor

  XLONG .drag_start_x
  XLONG .drag_start_y

  ULONG .invisible_char

  XLONG .width_chars
END TYPE

