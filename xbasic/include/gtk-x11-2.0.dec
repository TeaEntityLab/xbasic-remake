' * of the option menu
EXTERNAL CFUNCTION XLONG gtk_menu_get_active	  (XLONG)
EXTERNAL CFUNCTION gtk_menu_set_active	  (XLONG,	ULONG)
' set/get the accelerator group that holds global accelerators (should
' * be added to the corresponding toplevel with gtk_window_add_accel_group().
EXTERNAL CFUNCTION gtk_menu_set_accel_group	 (XLONG,	XLONG)
EXTERNAL CFUNCTION gtk_menu_set_accel_path  (XLONG,	XLONG)
' A reference count is kept for a widget when it is attached to
' * a particular widget. This is typically a menu item; it may also
' * be a widget with a popup menu - for instance, the Notebook widget.
EXTERNAL CFUNCTION gtk_menu_detach	 (XLONG)
' This should be dumped in favor of data set when the menu is popped
' * up - that is currently in the ItemFactory code, but should be
' * in the Menu code.
EXTERNAL CFUNCTION XLONG gtk_menu_get_attach_widget (XLONG)
