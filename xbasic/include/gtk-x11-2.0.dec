EXTERNAL CFUNCTION gtk_dialog_set_alternative_button_order_from_array (XLONG, XLONG, XLONG)

'Emit response signal
EXTERNAL CFUNCTION gtk_dialog_response (XLONG, XLONG)

'Returns response_id
EXTERNAL CFUNCTION XLONG gtk_dialog_run (XLONG)

'GTK returns this if a response widget has no response_id,
'or if the dialog gets programmatically hidden or destroyed.

$$GTK_RESPONSE_NONE = -1

'GTK won't return these unless you pass them in
'as the response for an action widget. They are
'for your convenience.

$$GTK_RESPONSE_REJECT = -2
$$GTK_RESPONSE_ACCEPT = -3

'If the dialog is deleted.
$$GTK_RESPONSE_DELETE_EVENT = -4

'These are returned from GTK dialogs, and you can also use them
'yourself if you like.

$$GTK_RESPONSE_OK     = -5
$$GTK_RESPONSE_CANCEL = -6
$$GTK_RESPONSE_CLOSE  = -7
$$GTK_RESPONSE_YES    = -8
$$GTK_RESPONSE_NO     = -9
$$GTK_RESPONSE_APPLY  = -10
$$GTK_RESPONSE_HELP   = -11

$$GTK_DIALOG_MODAL               = 1  'call gtk_window_set_modal (win, TRUE)
$$GTK_DIALOG_DESTROY_WITH_PARENT = 2  'call gtk_window_set_destroy_with_parent ()
$$GTK_DIALOG_NO_SEPARATOR        = 4  'no separator bar above buttons

