EXTERNAL CFUNCTION XLONG gtk_font_selection_dialog_new (XLONG)
'
EXTERNAL CFUNCTION ULONG gtk_font_selection_get_type	  ()
EXTERNAL CFUNCTION XLONG gtk_font_selection_new()
EXTERNAL CFUNCTION XLONG gtk_font_selection_get_font_name	(XLONG)
EXTERNAL CFUNCTION XLONG gtk_font_selection_get_font	(XLONG)
EXTERNAL CFUNCTION XLONG gtk_font_selection_set_font_name  (XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG gtk_font_selection_get_preview_text (XLONG)
EXTERNAL CFUNCTION gtk_font_selection_set_preview_text (XLONG,	XLONG)
'****************************************************************************
' * GtkFontSelectionDialog functions.
' *   most of these functions simply call the corresponding function in the
' *   GtkFontSelection.
' ****************************************************************************
' This returns the X Logical Font Description fontname, or NULL if no font
'   is selected. Note that there is a slight possibility that the font might not
'   have been loaded OK. You should call gtk_font_selection_dialog_get_font()
'   to see if it has been loaded OK.
'   You should g_free() the returned font name after you're done with it.
EXTERNAL CFUNCTION XLONG gtk_font_selection_dialog_get_font_name  (XLONG)
' This will return the current GdkFont, or NULL if none is selected or there
'   was a problem loading it. Remember to use gdk_font_ref/unref() if you want
'   to use the font (in a style, for example).
EXTERNAL CFUNCTION XLONG gtk_font_selection_dialog_get_font (XLONG)
' This sets the currently displayed font. It should be a valid X Logical
'   Font Description font name (anything else will be ignored), e.g.
'   "-adobe-courier-bold-o-normal--25-*-*-*-*-*-*-*"
'   It returns TRUE on success.
EXTERNAL CFUNCTION XLONG gtk_font_selection_dialog_set_font_name  (XLONG,	XLONG)
' This returns the text in the preview entry. You should copy the returned   text if you need it.
EXTERNAL CFUNCTION XLONG gtk_font_selection_dialog_get_preview_text (XLONG)
' This sets the text in the preview entry. It will be copied by the entry,   so there's no need to g_strdup() it first.
EXTERNAL CFUNCTION gtk_font_selection_dialog_set_preview_text (XLONG,	XLONG)

