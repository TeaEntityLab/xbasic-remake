' freeze all visual updates of the list, and then thaw the list after
' * you have made a number of changes and the updates wil occure in a
' * more efficent mannor than if you made them on a unfrozen list
EXTERNAL CFUNCTION gtk_clist_freeze (XLONG)
EXTERNAL CFUNCTION gtk_clist_thaw   (XLONG)
' show and hide the column title buttons
EXTERNAL CFUNCTION gtk_clist_column_titles_show (XLONG)
EXTERNAL CFUNCTION gtk_clist_column_titles_hide (XLONG)
' set the column title to be a active title (responds to button presses,
' * prelights, and grabs keyboard focus), or passive where it acts as just a title
EXTERNAL CFUNCTION gtk_clist_column_title_active   (XLONG,				      XLONG)
EXTERNAL CFUNCTION gtk_clist_column_title_passive  (XLONG,				      XLONG)
EXTERNAL CFUNCTION gtk_clist_column_titles_active  (XLONG)
EXTERNAL CFUNCTION gtk_clist_column_titles_passive (XLONG)
' set the title in the column title button
EXTERNAL CFUNCTION gtk_clist_set_column_title (XLONG,				 XLONG,				 XLONG)
' returns the title of column. Returns NULL if title is not set
EXTERNAL CFUNCTION XLONG gtk_clist_get_column_title (XLONG,				    XLONG)
' set a widget instead of a title for the column title button
EXTERNAL CFUNCTION gtk_clist_set_column_widget (XLONG,				  XLONG,				  XLONG)
' returns the column widget
EXTERNAL CFUNCTION XLONG gtk_clist_get_column_widget (XLONG,					 XLONG)
' set the justification on a column
EXTERNAL CFUNCTION gtk_clist_set_column_justification (XLONG,					 XLONG,					 XLONG)
' set visibility of a column
EXTERNAL CFUNCTION gtk_clist_set_column_visibility (XLONG,				      XLONG,				      XLONG)
' enable/disable column resize operations by mouse
EXTERNAL CFUNCTION gtk_clist_set_column_resizeable (XLONG,				      XLONG,				      XLONG)
' resize column automatically to its optimal width
EXTERNAL CFUNCTION gtk_clist_set_column_auto_resize (XLONG,				       XLONG,				       XLONG)
EXTERNAL CFUNCTION XLONG gtk_clist_columns_autosize (XLONG)
' return the optimal column width, i.e. maximum of all cell widths
EXTERNAL CFUNCTION XLONG gtk_clist_optimal_column_width (XLONG,				     XLONG)
' set the pixel width of a column; this is a necessary step in
' * creating a CList because otherwise the column width is chozen from
' * the width of the column title, which will never be right
EXTERNAL CFUNCTION gtk_clist_set_column_width (XLONG,				 XLONG,				 XLONG)
' set column minimum/maximum width. min/max_width < 0 => no restriction
EXTERNAL CFUNCTION gtk_clist_set_column_min_width (XLONG,				     XLONG,				     XLONG)
EXTERNAL CFUNCTION gtk_clist_set_column_max_width (XLONG,				     XLONG,				     XLONG)
' change the height of the rows, the default (height=0) is
' * the hight of the current font.
EXTERNAL CFUNCTION gtk_clist_set_row_height (XLONG,	ULONG)
' scroll the viewing area of the list to the given column and row;
' * row_align and col_align are between 0-1 representing the location the
' * row should appear on the screnn, 0.0 being top or left, 1.0 being
' * bottom or right; if row or column is -1 then then there is no change
EXTERNAL CFUNCTION gtk_clist_moveto (XLONG,		       XLONG,		       XLONG,		       SINGLE,		       SINGLE)
' returns whether the row is visible
EXTERNAL CFUNCTION XLONG gtk_clist_row_is_visible (XLONG,					XLONG)
' returns the cell type
EXTERNAL CFUNCTION XLONG gtk_clist_get_cell_type (XLONG,				     XLONG,				     XLONG)
' sets a given cell's text, replacing its current contents
EXTERNAL CFUNCTION gtk_clist_set_text (XLONG,			 XLONG,			 XLONG,			 XLONG)
' for the "get" functions, any of the return pointer can be
' * NULL if you are not interested
EXTERNAL CFUNCTION XLONG gtk_clist_get_text (XLONG,			 XLONG,			 XLONG,			 XLONG)
' sets a given cell's pixmap, replacing its current contents
EXTERNAL CFUNCTION gtk_clist_set_pixmap (XLONG,			   XLONG,			   XLONG,			   XLONG,			   XLONG)
EXTERNAL CFUNCTION XLONG gtk_clist_get_pixmap (XLONG,			   XLONG,			   XLONG,			   XLONG,			   XLONG)
' sets a given cell's pixmap and text, replacing its current contents
EXTERNAL CFUNCTION gtk_clist_set_pixtext (XLONG,			    XLONG,			    XLONG,			    XLONG,			    UBYTE,			    XLONG,			    XLONG)
EXTERNAL CFUNCTION XLONG gtk_clist_get_pixtext (XLONG,			    XLONG,			    XLONG,			    XLONG,			    XLONG,			    XLONG,			    XLONG)
' sets the foreground color of a row, the color must already
' * be allocated
EXTERNAL CFUNCTION gtk_clist_set_foreground (XLONG,			       XLONG,			       XLONG)
' sets the background color of a row, the color must already
' * be allocated
EXTERNAL CFUNCTION gtk_clist_set_background (XLONG,			       XLONG,			       XLONG)
' set / get cell styles
EXTERNAL CFUNCTION gtk_clist_set_cell_style (XLONG,			       XLONG,			       XLONG,			       XLONG)
EXTERNAL CFUNCTION XLONG gtk_clist_get_cell_style (XLONG,				    XLONG,				    XLONG)
EXTERNAL CFUNCTION gtk_clist_set_row_style (XLONG,			      XLONG,			      XLONG)
EXTERNAL CFUNCTION XLONG gtk_clist_get_row_style (XLONG,				   XLONG)
' this sets a horizontal and vertical shift for drawing
' * the contents of a cell; it can be positive or negitive;
' * this is particulary useful for indenting items in a column
EXTERNAL CFUNCTION gtk_clist_set_shift (XLONG,			  XLONG,			  XLONG,			  XLONG,			  XLONG)
' set/get selectable flag of a single row
EXTERNAL CFUNCTION gtk_clist_set_selectable (XLONG,			       XLONG,			       XLONG)
EXTERNAL CFUNCTION XLONG gtk_clist_get_selectable (XLONG,				   XLONG)
' prepend/append returns the index of the row you just added,
' * making it easier to append and modify a row
EXTERNAL CFUNCTION XLONG gtk_clist_prepend (XLONG,		        XLONG)
EXTERNAL CFUNCTION XLONG gtk_clist_append  (XLONG,			XLONG)
' inserts a row at index row and returns the row where it was
' * actually inserted (may be different from "row" in auto_sort mode)
EXTERNAL CFUNCTION XLONG gtk_clist_insert (XLONG,		       XLONG,		       XLONG)
' removes row at index row
EXTERNAL CFUNCTION gtk_clist_remove (XLONG,		       XLONG)
' sets a arbitrary data pointer for a given row
EXTERNAL CFUNCTION gtk_clist_set_row_data (XLONG,			     XLONG,			     XLONG)
' sets a data pointer for a given row with destroy notification
EXTERNAL CFUNCTION gtk_clist_set_row_data_full (XLONG,			          XLONG,			          XLONG,				  XLONG)
' returns the data set for a row
EXTERNAL CFUNCTION XLONG gtk_clist_get_row_data (XLONG,				 XLONG)
' givin a data pointer, find the first (and hopefully only!)
' * row that points to that data, or -1 if none do
EXTERNAL CFUNCTION XLONG gtk_clist_find_row_from_data (XLONG,				   XLONG)
' force selection of a row
EXTERNAL CFUNCTION gtk_clist_select_row (XLONG,			   XLONG,			   XLONG)
' force unselection of a row
EXTERNAL CFUNCTION gtk_clist_unselect_row (XLONG,			     XLONG,			     XLONG)
' undo the last select/unselect operation
EXTERNAL CFUNCTION gtk_clist_undo_selection (XLONG)
' clear the entire list -- this is much faster than removing
' * each item with gtk_clist_remove
EXTERNAL CFUNCTION gtk_clist_clear (XLONG)
' return the row column corresponding to the x and y coordinates,
' * the returned values are only valid if the x and y coordinates
' * are respectively to a window == clist->clist_window
EXTERNAL CFUNCTION XLONG gtk_clist_get_selection_info (XLONG,			     	   XLONG,			     	   XLONG,			     	   XLONG,			     	   XLONG)
' in multiple or extended mode, select all rows
EXTERNAL CFUNCTION gtk_clist_select_all (XLONG)
' in all modes except browse mode, deselect all rows
EXTERNAL CFUNCTION gtk_clist_unselect_all (XLONG)
