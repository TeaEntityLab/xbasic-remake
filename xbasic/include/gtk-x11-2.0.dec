'#########################
'########  gtktexttag
'#########################

TYPE GTKTEXTTAG
  GOBJECT .parent_instance
  XLONG .table
  XLONG .name                   ' Name of this tag.  This field is actually
                                 '* a pointer to the key from the entry in
                                 '* tkxt->tagTable, so it needn't be freed
                                 '* explicitly.
  XLONG .priority         ' Priority of this tag within widget.  0
                         '* means lowest priority.  Exactly one tag
                         '* has each integer value between 0 and
                         '* numTags-1.
'   * Information for displaying text with this tag.  The information
'   * belows acts as an override on information specified by lower-priority
'   * tags.  If no value is specified, then the next-lower-priority tag
'   * on the text determins the value.  The text widget itself provides
'   * defaults if no tag specifies an override.
  XLONG .values
'  /* Flags for whether a given value is set; if a value is unset, then
'   * this tag does not affect it.
	ULONG .bitfield  ' the following items are bitfields
'  ULONG .bg_color_set ': 1
'  ULONG .bg_stipple_set ': 1
'  ULONG .fg_color_set ': 1
'  ULONG .scale_set ': 1
'  ULONG .fg_stipple_set ': 1
'  ULONG .justification_set ': 1
'  ULONG .left_margin_set ': 1
'  ULONG .indent_set ': 1
'  ULONG .rise_set ': 1
'  ULONG .strikethrough_set ': 1
'  ULONG .right_margin_set ': 1
'  ULONG .pixels_above_lines_set ': 1
'  ULONG .pixels_below_lines_set ': 1
'  ULONG .pixels_inside_wrap_set ': 1
'  ULONG .tabs_set ': 1
'  ULONG .underline_set ': 1
'  ULONG .wrap_mode_set ': 1
'  ULONG .bg_full_height_set ': 1
'  ULONG .invisible_set ': 1
'  ULONG .editable_set ': 1
'  ULONG .language_set ': 1
'  ULONG .pg_bg_color_set ': 1
'  ULONG .pad1 ': 1
'  ULONG .pad2 ': 1
END TYPE

EXTERNAL CFUNCTION ULONG gtk_text_tag_get_type     ()
EXTERNAL CFUNCTION XLONG gtk_text_tag_new          (XLONG)
EXTERNAL CFUNCTION XLONG gtk_text_tag_get_priority (XLONG)
EXTERNAL CFUNCTION gtk_text_tag_set_priority (XLONG, XLONG)
EXTERNAL CFUNCTION XLONG gtk_text_tag_event        (XLONG, XLONG, XLONG, XLONG)
' * Style object created by folding a set of tags together
TYPE GTKTEXTAPPEARANCE
'  /*< public >
  GDKCOLOR .bg_color
  GDKCOLOR .fg_color
  XLONG .bg_stipple
  XLONG .fg_stipple
'  /* super/subscript rise, can be negative
  XLONG .rise
'  /*< private >
'  /* I'm not sure this can really be used without breaking some things
'   * an app might do :-/
  XLONG .padding1
'  < public >
	ULONG	.bitfields ' the following 9 items are bitfields
'  ULONG .underline ': 4           PangoUnderline
'  ULONG .strikethrough ': 1
'   Whether to use background-related values this is irrelevant for
'   * the values struct when in a tag, but is used for the composite
'   * values struct; it's true if any of the tags being composited
'   * had background stuff set.
'  ULONG .draw_bg ': 1
'   These are only used when we are actually laying out and rendering
'   * a paragraph not when a GtkTextAppearance is part of a
'   * GtkTextAttributes.
'  ULONG .inside_selection ': 1
'  ULONG .is_text ': 1
'  < private >
'  ULONG .pad1 ': 1
'  ULONG .pad2 ': 1
'  ULONG .pad3 ': 1
'  ULONG .pad4 ': 1
END TYPE

TYPE GTKTEXTATTRIBUTES
'  /*< private >
  ULONG .refcount
'  /*< public >
  GTKTEXTAPPEARANCE .appearance
  XLONG .justification
  XLONG .direction
'  /* Individual chunks of this can be set/unset as a group
  XLONG .font
  DOUBLE .font_scale
  XLONG .left_margin
  XLONG .indent
	XLONG .right_margin
  XLONG .pixels_above_lines
  XLONG .pixels_below_lines
  XLONG .pixels_inside_wrap
  XLONG .tabs
  XLONG .wrap_mode        ' How to handle wrap-around for this tag.
                                 '* Must be GTK_WRAPMODE_CHAR,
                                 '* GTK_WRAPMODE_NONE, GTK_WRAPMODE_WORD
  XLONG .language
'  /*< private >
  XLONG .pg_bg_color
'  < public >
'   hide the text
	XLONG	.bitfields  ' the following 8 items are bitfields
'  ULONG .invisible ': 1
'   Background is fit to full line height rather than
'   * baseline +/- ascent/descent (font height)
'  ULONG .bg_full_height ': 1
'   can edit this text
'  ULONG .editable ': 1
'   colors are allocated etc.
'  ULONG .realized ': 1
'  < private >
'  ULONG .pad1 ': 1
'  ULONG .pad2 ': 1
'  ULONG .pad3 ': 1
'  ULONG .pad4 ': 1
END TYPE

