EXTERNAL CFUNCTION gtk_object_weakref	  (XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION gtk_object_weakunref (XLONG,	XLONG,	XLONG)
' Set 'data' to the "object_data" field of the object. The
' *  data is indexed by the "key". If there is already data
' *  associated with "key" then the new data will replace it.
' *  If 'data' is NULL then this call is equivalent to
' *  'gtk_object_remove_data'.
' *  The gtk_object_set_data_full variant acts just the same,
' *  but takes an additional argument which is a function to
' *  be called when the data is removed.
' *  `gtk_object_remove_data' is equivalent to the above,
' *  where 'data' is NULL
' *  `gtk_object_get_data' gets the data associated with "key".
EXTERNAL CFUNCTION gtk_object_set_data_full    (XLONG,	XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION gtk_object_remove_data	     (XLONG,	XLONG)
EXTERNAL CFUNCTION gtk_object_remove_no_notify (XLONG,	XLONG)
' Set/get the "user_data" object data field of "object". It should
' *  be noted that these functions are no different than calling
' *  `gtk_object_set_data'/`gtk_object_get_data' with a key of "user_data".
' *  They are merely provided as a convenience.
EXTERNAL CFUNCTION gtk_object_set_user_data (XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG gtk_object_get_user_data (XLONG)
' Object-level methods
' Object data method variants that operate on key ids.
EXTERNAL CFUNCTION gtk_object_set_data_by_id		(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION gtk_object_set_data_by_id_full	(XLONG,	XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG gtk_object_get_data_by_id	(XLONG,	XLONG)
EXTERNAL CFUNCTION gtk_object_remove_data_by_id	(XLONG,	XLONG)
EXTERNAL CFUNCTION gtk_object_remove_no_notify_by_id	(XLONG,	XLONG)
' GtkArg flag bits for gtk_object_add_arg_type
EXTERNAL CFUNCTION gtk_object_get		(XLONG,	XLONG, ...)
EXTERNAL CFUNCTION gtk_object_set		(XLONG,	XLONG, ...)
EXTERNAL CFUNCTION gtk_object_add_arg_type	(XLONG,	XLONG,	ULONG,	ULONG)

