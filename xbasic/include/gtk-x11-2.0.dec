'#########################
'########  gtktext
'#########################

TYPE GTKPROPERTYMARK
  '/* Position in list.' */
  XLONG .property

  '/* Offset into that property.' */
  ULONG .offset

  '/* Current index.' */
  ULONG .index
END TYPE

TYPE GTKTEXT
  GTKOLDEDITABLE .old_editable

  XLONG .text_area

  XLONG .hadj
  XLONG .vadj

  XLONG .gc

  XLONG .line_wrap_bitmap
  XLONG .line_arrow_bitmap

		      '/* GAPPED TEXT SEGMENT' */

  '/* The text, a single segment of text a'la emacs, with a gap
  ' * where insertion occurs.' */
  UNION
		XLONG .wctext
		XLONG .chtext
	END UNION
  '/* The allocated length of the text segment.' */
  ULONG .text_len
  '/* The gap position, index into address where a char
  ' * should be inserted.' */
  ULONG .gap_position
  '/* The gap size, s.t. *(text + gap_position + gap_size) is
  ' * the first valid character following the gap.' */
  ULONG .gap_size
  '/* The last character position, index into address where a
  ' * character should be appeneded.  Thus, text_end - gap_size
  ' * is the length of the actual data.' */
  ULONG .text_end
			'/* LINE START CACHE' */
  '/* A cache of line-start information.  Data is a LineParam*.' */
  XLONG .line_start_cache
  '/* Index to the start of the first visible line.' */
  ULONG .first_line_start_index
  '/* The number of pixels cut off of the top line.' */
  ULONG .first_cut_pixels
  '/* First visible horizontal pixel.' */
  ULONG .first_onscreen_hor_pixel
  '/* First visible vertical pixel.' */
  ULONG .first_onscreen_ver_pixel

			     '/* FLAGS' */

  '/* True iff this buffer is wrapping lines, otherwise it is using a
  ' * horizontal scrollbar.' */
	ULONG .flags
'  guint line_wrap : 1;
'  guint word_wrap : 1;
 '/* If a fontset is supplied for the widget, use_wchar become true,
  ' * and we use GdkWchar as the encoding of text.' */
'  guint use_wchar : 1;

  '/* Frozen, don't do updates. @@@ fixme' */
  ULONG .freeze_count
			'/* TEXT PROPERTIES' */

  '/* A doubly-linked-list containing TextProperty objects.' */
  XLONG .text_properties
  '/* The end of this list.' */
  XLONG .text_properties_end
  '/* The first node before or on the point along with its offset to
  ' * the point and the buffer's current point.  This is the only
  ' * PropertyMark whose index is guaranteed to remain correct
  ' * following a buffer insertion or deletion.' */
  XLONG .point

			  '/* SCRATCH AREA' */

  UNION
	 XLONG .wcscratch_buffer
	 XLONG .chscratch_buffer
	END UNION
	  '} scratch_buffer;
  ULONG .scratch_buffer_len

			   '/* SCROLLING' */

  SLONG .last_ver_value

			     '/* CURSOR' */

  SLONG .cursor_pos_x       '/* Position of cursor.' */
  SLONG .cursor_pos_y       '/* Baseline of line cursor is drawn on.' */
  XLONG .cursor_mark        '/* Where it is in the buffer.' */
  XLONG .cursor_char        '/* Character to redraw.' */
  SBYTE .cursor_char_offset '/* Distance from baseline of the font.' */
  SLONG .cursor_virtual_x  '/* Where it would be if it could be.' */
  SLONG .cursor_drawn_level '/* How many people have undrawn.' */

			  '/* Current Line' */

  XLONG .current_line

			   '/* Tab Stops' */

  XLONG .tab_stops
  SLONG .default_tab_width

  XLONG .current_font	'/* Text font for current style' */

  '/* Timer used for auto-scrolling off ends' */
  SLONG .timer

  ULONG .button			'/* currently pressed mouse button' */
  XLONG .bg_gc			'/* gc for drawing background pixmap' */
END TYPE

