'#########################
'########  gtkitemfactory
'#########################

TYPE GTKITEMFACTORY
  GTKOBJECT		 .object

  XLONG .path
  XLONG .accel_group
  XLONG .widget
  XLONG .items

  XLONG .translate_func
  XLONG .translate_data
  XLONG .translate_notify
END TYPE

TYPE GTKITEMFACTORYENTRY
  XLONG .path
  XLONG .accelerator

  XLONG .callback
  ULONG	.callback_action

'   * possible values:
'   * NULL		-> "<Item>"
'   * ""			-> "<Item>"
'   * "<Title>"		-> create a title item
'   * "<Item>"		-> create a simple item
'   * "<ImageItem>"	-> create an item holding an image
'   * "<StockItem>"	-> create an item holding a stock image
'   * "<CheckItem>"	-> create a check item
'   * "<ToggleItem>"	-> create a toggle item
'   * "<RadioItem>"	-> create a radio item
'   * <path>		-> path of a radio item to link against
'   * "<Separator>"	-> create a separator
'   * "<Tearoff>"	-> create a tearoff separator
'   * "<Branch>"		-> create an item to hold sub items
'   * "<LastBranch>"	-> create a right justified item to hold sub items

  XLONG		 .item_type

'   * Extra data for some item types:
'   *  ImageItem  -> pointer to inlined pixbuf stream
'   *  StockItem  -> name of stock item
  XLONG .extra_data
END TYPE

TYPE GTKITEMFACTORYITEM
  XLONG .path
  XLONG .widgets
END TYPE

EXTERNAL CFUNCTION XLONG gtk_item_factory_new (XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION gtk_item_factory_create_items (XLONG, XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG gtk_item_factory_get_widget (XLONG, XLONG)

'#########################
'########  gtkselection
'#########################

EXTERNAL CFUNCTION gtk_selection_data_set (XLONG, XLONG, XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG gtk_selection_owner_set (XLONG, XLONG, XLONG)
'
' The contents of a selection are returned in a GtkSelectionData
' * structure. selection/target identify the request.  type specifies
' * the type of the return; if length < 0, and the data should be
' * ignored. This structure has object semantics - no fields should be
' * modified directly, they should not be created directly, and
' * pointers to them should not be stored beyond the duration of a
' * callback. (If the last is changed, we'll need to add reference
' * counting.) The time field gives the timestamp at which the data was
' * sent.

TYPE GTKSELECTIONDATA
  XLONG .selection
  XLONG .target
  XLONG .type
  XLONG .format
  XLONG .data
  XLONG .length
  XLONG .display
END TYPE

TYPE GTKTARGETENTRY
  XLONG .target
  ULONG .flags
  ULONG .info
END TYPE

' These structures not public, and are here only for the convenience of gtkdnd.c

' This structure is a list of destinations, and associated guint id's
TYPE GTKTARGETLIST
  XLONG .list
  ULONG .ref_count
END TYPE

TYPE GTKTARGETPAIR
  XLONG .target
  ULONG .flags
  ULONG .info
END TYPE

