'#########################
'########  gtktreemodelsort
'#########################

TYPE GtkTreeModelSort
  GOBJECT .parent

  '/* < private >' */
  XLONG .root
  SLONG .stamp
  ULONG .child_flags
  XLONG .child_model
  SLONG .zero_ref_count

  '/* sort information' */
  XLONG .sort_list
  SLONG .sort_column_id
  XLONG .order

  '/* default sort' */
  XLONG .default_sort_func
  XLONG .default_sort_data
  XLONG .default_sort_destroy

  '/* signal ids' */
  ULONG .changed_id
  ULONG .inserted_id
  ULONG .has_child_toggled_id
  ULONG .deleted_id
  ULONG .reordered_id
END TYPE

