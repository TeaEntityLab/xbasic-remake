TYPE GTKTREEVIEWCOLUMN
  GTKOBJECT .parent
  XLONG .tree_view
  XLONG .button
  XLONG .child
  XLONG .arrow
  XLONG .alignment
  XLONG .window
  XLONG .editable_widget
  SINGLE .xalign
  ULONG .property_changed_signal
  XLONG .spacing
'  /* Sizing fields see gtk+/doc/tree-column-sizing.txt for more information on them
  XLONG .column_type
  XLONG .requested_width
  XLONG .button_request
  XLONG .resized_width
  XLONG .width
  XLONG .fixed_width
  XLONG .min_width
  XLONG .max_width
'dragging columns
  XLONG .drag_x
  XLONG .drag_y
  XLONG .title
  XLONG .cell_list
'Sorting
  ULONG .sort_clicked_signal
  ULONG .sort_column_changed_signal
  XLONG .sort_column_id
  XLONG .sort_order
'Flags
	ULONG .flags
'  ULONG .visible
'  ULONG .resizable
'  ULONG .clickable
'  ULONG .dirty
'  ULONG .show_sort_indicator
'  ULONG .maybe_reordered
'  ULONG .reorderable
'  ULONG .use_resized_width
'  ULONG .expand
END TYPE

