'########  gtkstyle
'#########################
TYPE GTKSTYLE
  GOBJECT .parent_instance
'< public >
  GDKCOLOR .fg[5]
  GDKCOLOR .bg[5]
  GDKCOLOR .light[5]
  GDKCOLOR .dark[5]
  GDKCOLOR .mid[5]
  GDKCOLOR .text[5]
  GDKCOLOR .base[5]
  GDKCOLOR .text_aa[5]		' Halfway between text/base

  GDKCOLOR .black
  GDKCOLOR .white
  XLONG .font_desc

  XLONG .xthickness
  XLONG .ythickness

  XLONG .fg_gc[5]
  XLONG .bg_gc[5]
  XLONG .light_gc[5]
  XLONG .dark_gc[5]
  XLONG .mid_gc[5]
  XLONG .text_gc[5]
  XLONG .base_gc[5]
  XLONG .text_aa_gc[5]
  XLONG .black_gc
  XLONG .white_gc
  XLONG .bg_pixmap[5]
'< private >
  XLONG .attach_count
  XLONG .depth
  XLONG .colormap
  XLONG .private_font
  XLONG .private_font_desc 'Font description for style->private_font or %NULL
'the RcStyle from which this style was created
  XLONG	 .rc_style
  XLONG	 .styles 					'of type GtkStyle*
  XLONG	 .property_cache
  XLONG  .icon_factories  	'of type GtkIconFactory*
END TYPE

TYPE GTKBORDER
  SLONG .left
  SLONG .right
  SLONG .top
  SLONG .bottom
END TYPE

