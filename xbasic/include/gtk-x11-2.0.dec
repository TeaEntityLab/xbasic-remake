'#########################
'########  gtkwindow
'#########################

TYPE GTKWINDOW
  GTKBIN .bin

  XLONG .title
  XLONG .wmclass_name
  XLONG .wmclass_class
  XLONG .wm_role

  XLONG .focus_widget
  XLONG .default_widget
  XLONG .transient_parent
  XLONG .geometry_info
  XLONG .frame
  XLONG .group

  USHORT .configure_request_count

	XLONG .bitfields ' 20 following bitfields

'  ULONG .allow_shrink:1
'  ULONG .allow_grow:1
'  ULONG .configure_notify_received:1

''The following flags are initially TRUE (before a window is mapped).
''They cause us to compute a configure request that involves
''default-only parameters. Once mapped, we set them to FALSE.
''Then we set them to TRUE again on unmap (for position) and on unrealize (for size).

'  ULONG .need_default_position:1
'  ULONG .need_default_size:1
'  ULONG .position:3
''GtkWindowType
'	 ULONG .type :4
'  ULONG .has_user_ref_count:1
'  ULONG .has_focus:1

'  ULONG .modal:1
'  ULONG .destroy_with_parent:1

'  ULONG .has_frame:1

''gtk_window_iconify() called before realization
'  ULONG .iconify_initially :1
'  ULONG .stick_initially:1
'  ULONG .maximize_initially:1
'  ULONG .decorated:1

'  ULONG .type_hint:3
''GdkWindowTypeHint if the hint is one of the original eight. If not, then
''it contains GDK_WINDOW_TYPE_HINT_NORMAL
''GdkGravity
'	ULONG .gravity:5

'  ULONG .is_active:1
'  ULONG .has_toplevel_focus:1

  ULONG .frame_left
  ULONG .frame_top
  ULONG .frame_right
  ULONG .frame_bottom

  ULONG .keys_changed_handler

  XLONG .mnemonic_modifier
  XLONG .screen
END TYPE

