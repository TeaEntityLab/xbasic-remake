'#########################
'########  gtktextview
'#########################

$$GTK_TEXT_WINDOW_PRIVATE = 0
$$GTK_TEXT_WINDOW_WIDGET = 1
$$GTK_TEXT_WINDOW_TEXT = 2
$$GTK_TEXT_WINDOW_LEFT = 3
$$GTK_TEXT_WINDOW_RIGHT = 4
$$GTK_TEXT_WINDOW_TOP = 5
$$GTK_TEXT_WINDOW_BOTTOM = 6
'} GtkTextWindowType;

TYPE GTKTEXTVIEW
  GTKCONTAINER .parent_instance
  XLONG .layout
  XLONG .buffer
  XLONG .selection_drag_handler
  XLONG .scroll_timeout
'Default style settings
  XLONG .pixels_above_lines
  XLONG .pixels_below_lines
  XLONG .pixels_inside_wrap
  XLONG .wrap_mode
  XLONG .justify
  XLONG .left_margin
  XLONG .right_margin
  XLONG .indent
  XLONG .tabs
	ULONG .flags
'  ULONG .editable
'  ULONG .overwrite_mode
'  ULONG .cursor_visible
''if we have reset the IM since the last character entered
'  ULONG .need_im_reset
'  ULONG .accepts_tab
'  ULONG .width_changed
'  /* debug flag - means that we've validated onscreen since the
'   * last "invalidate" signal from the layout
  ULONG .onscreen_validated
  ULONG .mouse_cursor_obscured
  XLONG .text_window
  XLONG .left_window
  XLONG .right_window
  XLONG .top_window
  XLONG .bottom_window
  XLONG .hadjustment
  XLONG .vadjustment
  XLONG .xoffset               ' Offsets between widget coordinates and buffer coordinates
  XLONG .yoffset
  XLONG .width                  ' Width and height of the buffer
  XLONG .height
'  /* The virtual cursor position is normally the same as the
'   * actual (strong) cursor position, except in two circumstances:
'   *
'   * a) When the cursor is moved vertically with the keyboard
'   * b) When the text view is scrolled with the keyboard
'   *
'   * In case a), virtual_cursor_x is preserved, but not virtual_cursor_y
'   * In case b), both virtual_cursor_x and virtual_cursor_y are preserved.
  XLONG .virtual_cursor_x           ' -1 means use actual cursor position
  XLONG .virtual_cursor_y           ' -1 means use actual cursor position
  XLONG .first_para_mark    ' Mark at the beginning of the first onscreen paragraph
  XLONG .first_para_pixels          ' Offset of top of screen in the first onscreen paragraph
  XLONG .dnd_mark
  ULONG .blink_timeout
  ULONG .first_validate_idle            ' Idle to revalidate onscreen portion, runs before resize
  ULONG .incremental_validate_idle      ' Idle to revalidate offscreen portions, runs after redraw
  XLONG .im_context
  XLONG .popup_menu
  XLONG .drag_start_x
  XLONG .drag_start_y
  XLONG .children
  XLONG .pending_scroll
  XLONG .pending_place_cursor_button
END TYPE

