'#########################
'########  gtkrange
'#########################

TYPE GTKRANGE
  GTKWIDGET .widget
  XLONG .adjustment
  XLONG .update_policy
	ULONG .flags1
'  ULONG .inverted
''  /*< protected >
'  ULONG .flippable
''  /* Steppers are: < > ---- < >
''   *               a b      c d
''
'  ULONG .has_stepper_a
'  ULONG .has_stepper_b
'  ULONG .has_stepper_c
'  ULONG .has_stepper_d
'  ULONG .need_recalc
'  ULONG .slider_size_fixed
  XLONG .min_slider_size
  XLONG .orientation
'  /* Area of entire stepper + trough assembly in widget->window coords
  GDKRECTANGLE .range_rect
'   Slider range along the long dimension, in widget->window coords
  XLONG .slider_start
	XLONG .slider_end
'   Round off value to this many digits, -1 for no rounding
  XLONG .round_digits
'  /*< private >
	ULONG .flags2
'  ULONG .trough_click_forward '  /* trough click was on the forward side of slider
'  ULONG .update_pending '       /* need to emit value_changed
  XLONG .layout
  XLONG .timer
  XLONG .slide_initial_slider_position
  XLONG .slide_initial_coordinate
  ULONG .update_timeout_id
  XLONG .event_window
END TYPE

