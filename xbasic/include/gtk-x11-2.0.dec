EXTERNAL CFUNCTION XLONG gtk_menu_get_tearoff_state   (XLONG)
' This sets the window manager title for the window that
' * appears when a menu is torn off
EXTERNAL CFUNCTION gtk_menu_set_title   (XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG gtk_menu_get_title  (XLONG)
