$$GTK_TREE_VIEW_LINE = 0  ' default view mode
$$GTK_TREE_VIEW_ITEM = 1
' GtkTreeViewMode;

TYPE GTKTREE
  GTKCONTAINER .container
  XLONG .children
  XLONG .root_tree ' owner of selection list
  XLONG .tree_owner
  XLONG .selection
  ULONG .level
  ULONG .indent_value
  ULONG .current_indent
	ULONG .bitfields ' 3 bitfields, selection_mode, view_mode, and view_line
'  ULONG .selection_mode ': 2
'  ULONG .view_mode ': 1
'  ULONG .view_line ': 1
END TYPE

