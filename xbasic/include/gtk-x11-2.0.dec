TYPE GTKIMAGEPIXMAPDATA
  XLONG .pixmap
END TYPE

TYPE GTKIMAGEIMAGEDATA
  XLONG .image
END TYPE

TYPE GTKIMAGEPIXBUFDATA
  XLONG .pixbuf
END TYPE

TYPE GTKIMAGESTOCKDATA
  XLONG .stock_id
END TYPE

TYPE GTKIMAGEICONSETDATA
  XLONG .icon_set
END TYPE

TYPE GTKIMAGEANIMATIONDATA
  XLONG .anim
  XLONG .iter
  ULONG .frame_timeout
END TYPE

TYPE GTKIMAGEICONNAMEDATA
  XLONG .icon_name
  XLONG .pixbuf
  ULONG .theme_change_id
END TYPE

TYPE GTKIMAGEGICONDATA
  XLONG .icon
  XLONG .pixbuf
  ULONG .theme_change_id
END TYPE

TYPE GTKIMAGE
  GTKMISC .misc
  XLONG .storage_type
  UNION
    GTKIMAGEPIXMAPDATA .pixmap
    GTKIMAGEIMAGEDATA .image
    GTKIMAGEPIXBUFDATA .pixbuf
    GTKIMAGESTOCKDATA .stock
    GTKIMAGEICONSETDATA .icon_set
    GTKIMAGEANIMATIONDATA .anim
    GTKIMAGEICONNAMEDATA .name
  END UNION
'Only used with GTK_IMAGE_PIXMAP, GTK_IMAGE_IMAGE
  XLONG .mask
'Only used with GTK_IMAGE_STOCK, GTK_IMAGE_ICON_SET, GTK_IMAGE_ICON_NAME
  XLONG .icon_size
END TYPE

