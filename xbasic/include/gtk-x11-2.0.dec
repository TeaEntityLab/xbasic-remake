'#########################
'########  gtkmenu
'#########################

TYPE GTKMENU
  GTKMENUSHELL .menu_shell
  XLONG .parent_menu_item
  XLONG .old_active_menu_item
  XLONG .accel_group
  XLONG .accel_path
  XLONG .position_func
  XLONG .position_func_data
  ULONG .toggle_size
'Do _not_ touch these widgets directly. We hide the reference
'count from the toplevel to the menu, so it must be restored
'before operating on these widgets
  XLONG .toplevel
  XLONG .tearoff_window
  XLONG .tearoff_hbox
  XLONG .tearoff_scrollbar
  XLONG .tearoff_adjustment
  XLONG .view_window
  XLONG .bin_window
  XLONG .scroll_offset
  XLONG .saved_scroll_offset
  XLONG .scroll_step
  ULONG .timeout_id
'When a submenu of this menu is popped up, motion in this
'region is ignored
  XLONG .navigation_region
  ULONG .navigation_timeout
	ULONG .flags
'  ULONG .needs_destruction_ref_count
'  ULONG .torn_off
''The tearoff is active when it is torn off and the not-torn-off
''menu is not popped up.
'  ULONG .tearoff_active
'  ULONG .scroll_fast
'  ULONG .upper_arrow_visible
'  ULONG .lower_arrow_visible
'  ULONG .upper_arrow_prelight
'  ULONG .lower_arrow_prelight
END TYPE

