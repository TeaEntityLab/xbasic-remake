'/* The private flags that are used in the private_flags member of GtkWidget.
' */
$$PRIVATE_GTK_USER_STYLE	= 1
$$PRIVATE_GTK_RESIZE_PENDING	= 4
$$PRIVATE_GTK_HAS_POINTER	= 8   '/* If the pointer is above a window belonging to the widget' */
$$PRIVATE_GTK_SHADOWED		= 16   '/* If there is a grab in effect shadowing the widget' */
$$PRIVATE_GTK_HAS_SHAPE_MASK	= 32
$$PRIVATE_GTK_IN_REPARENT       = 64
$$PRIVATE_GTK_DIRECTION_SET     = 128   '/* If the reading direction is not DIR_NONE' */
$$PRIVATE_GTK_DIRECTION_LTR     = 256   '/* If the reading direction is DIR_LTR' */
$$PRIVATE_GTK_ANCHORED          = 516   '/* If widget has a GtkWindow ancestor' */
$$PRIVATE_GTK_CHILD_VISIBLE     = 1 '<<  10,  '/* If widget should be mapped when parent is mapped' */
$$PRIVATE_GTK_REDRAW_ON_ALLOC   = 1 '<<  11,  '/* If we should queue a draw on the entire widget when it is reallocated' */
$$PRIVATE_GTK_ALLOC_NEEDED      = 1 '<<  12,  '/* If we we should allocate even if the allocation is the same' */
$$PRIVATE_GTK_REQUEST_NEEDED    = 1 '<<  13   '/* Whether we need to call gtk_widget_size_request' */
'} GtkPrivateFlags;

