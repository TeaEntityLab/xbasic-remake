	$$GTK_NO_WINDOW        = 32
  $$GTK_REALIZED         = 64
  $$GTK_MAPPED           = 128
  $$GTK_VISIBLE          = 256
  $$GTK_SENSITIVE        = 1024
  $$GTK_PARENT_SENSITIVE = 2048
  $$GTK_CAN_FOCUS        = 4096
  $$GTK_HAS_FOCUS        = 8192

'widget is allowed to receive the default via gtk_widget_grab_default
'and will reserve space to draw the default if possible

  $$GTK_CAN_DEFAULT      = 16384

'the widget currently is receiving the default action and should be drawn
'appropriately if possible

  $$GTK_HAS_DEFAULT      = 32768

  $$GTK_HAS_GRAB	       = 65536
  $$GTK_RC_STYLE	       = 131072
  $$GTK_COMPOSITE_CHILD  = 262144
  $$GTK_NO_REPARENT      = 524288
  $$GTK_APP_PAINTABLE    = 1048576

'the widget when focused will receive the default action and have
'HAS_DEFAULT set even if there is a different widget set as default

  $$GTK_RECEIVES_DEFAULT = 2097152

  $$GTK_DOUBLE_BUFFERED  = 4194304
  $$GTK_NO_SHOW_ALL      = 8388608

$$GTK_WIDGET_HELP_TOOLTIP = 0
$$GTK_WIDGET_HELP_WHATS_THIS = 1

TYPE GTKWIDGETAUXINFO
  XLONG .x
  XLONG .y
  XLONG .width
  XLONG .height
	XLONG .set  ' bitfields 1 & 2 are x_set and y_set
'  ULONG .x_set ': 1
'  ULONG .y_set ': 1
END TYPE

TYPE GTKWIDGETSHAPEINFO
  SSHORT .offset_x
  SSHORT .offset_y
  XLONG .shape_mask
END TYPE

'#########################
'########  gtkcontainer
'#########################
TYPE GTKCONTAINER
  GTKWIDGET .widget
  XLONG .focus_child
	XLONG .bitfields  ' the following 5 items are bitfields
'  ULONG .border_width : 16
'  ULONG .need_resize : 1
'  ULONG .resize_mode : 2
'  ULONG .reallocate_redraws : 1
'  ULONG .has_focus_chain : 1
END TYPE

