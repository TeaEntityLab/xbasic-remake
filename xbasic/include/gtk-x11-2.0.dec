'#########################
'########  gtkcombo
'#########################

' you should access only the entry and list fields directly
TYPE GTKCOMBO
	GTKHBOX .hbox
'        /*< public >
	XLONG .entry
'        /*< private >
	XLONG .button
	XLONG .popup
	XLONG .popwin
'        /*< public >
	XLONG .list
'        /*< private >
	ULONG .entry_change_id
	ULONG .list_change_id	' unused

	ULONG .bitfields  ' the following 5 items are bitfields
'	ULONG .value_in_list':1
'	ULONG .ok_if_empty':1
'	ULONG .case_sensitive':1
'	ULONG .use_arrows':1
'	ULONG .use_arrows_always':1

  USHORT .current_button
	ULONG .activate_id
END TYPE


