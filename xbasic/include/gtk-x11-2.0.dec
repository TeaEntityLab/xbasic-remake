TYPE GTKBINDINGSET
  XLONG .set_name
  XLONG .priority
  XLONG .widget_path_pspecs
  XLONG .widget_class_pspecs
  XLONG .class_branch_pspecs
  XLONG .entries
  XLONG .current
  ULONG .parsed ': 1 bitfield From RC content
END TYPE

TYPE GTKBINDINGENTRY
'  '/* key portion
  ULONG .keyval
  XLONG .modifiers

  XLONG .binding_set
	ULONG .flags
'  ULONG .destroyed ': 1
'  ULONG .in_emission ': 1
'  guint                 marks_unbound : 1;
  XLONG .set_next
  XLONG .hash_next
  XLONG .signals
END TYPE

TYPE GTKBINDINGARG
  ULONG .arg_type
  UNION
    SINGLE .long_data
    DOUBLE	 .double_data
    XLONG .string_data
  END UNION
END TYPE

TYPE GTKBINDINGSIGNAL
  XLONG .next
  XLONG .signal_name
  ULONG .n_args
  XLONG .args
END TYPE

