TYPE GTKNOTEBOOK
  GTKCONTAINER .container
  XLONG .cur_page
  XLONG .children
  XLONG .first_tab 'The first tab visible (for scrolling notebooks)
  XLONG .focus_tab
  XLONG .menu
  XLONG .event_window
  ULONG .timer
  USHORT .tab_hborder
  USHORT .tab_vborder
	ULONG .flags
'  ULONG .show_tabs          ': 1;
'  ULONG .homogeneous        ': 1;
'  ULONG .show_border        ': 1;
'  ULONG .tab_pos            ': 2;
'  ULONG .scrollable         ': 1;
'  ULONG .in_child           ': 3;
'  ULONG .click_child        ': 3;
'  ULONG .button             ': 2;
'  ULONG .need_timer         ': 1;
'  ULONG .child_has_focus    ': 1;
'  ULONG .have_visible_child ': 1;
'  ULONG .focus_out         ': 1; 'Flag used by ::move-focus-out implementation
'  ULONG .has_before_previous ': 1;
'  ULONG .has_before_next     ': 1;
'  ULONG .has_after_previous  ': 1;
'  ULONG .has_after_next      ': 1;
END TYPE

