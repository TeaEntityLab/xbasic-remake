EXTERNAL CFUNCTION gtk_clist_swap_rows (XLONG,			  XLONG,			  XLONG)
' move row from source_row position to dest_row position
EXTERNAL CFUNCTION gtk_clist_row_move (XLONG,			 XLONG,			 XLONG)
' sets a compare function different to the default
EXTERNAL CFUNCTION gtk_clist_set_compare_func (XLONG,				 XLONG)
' the column to sort by
EXTERNAL CFUNCTION gtk_clist_set_sort_column (XLONG,				XLONG)
' how to sort : ascending or descending
EXTERNAL CFUNCTION gtk_clist_set_sort_type (XLONG,			      XLONG)
