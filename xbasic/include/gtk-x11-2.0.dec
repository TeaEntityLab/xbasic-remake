'#########################
'########  gtkclist
'#########################

TYPE GTKCLISTCELLINFO
  XLONG .row
  XLONG .column
END TYPE

TYPE GTKCLISTDESTINFO
  GTKCLISTCELLINFO .cell
  XLONG .insert_pos
END TYPE

TYPE GTKCLIST
  GTKCONTAINER .container
  USHORT .flags
  XLONG .reserved1
  XLONG .reserved2
  ULONG .freeze_count
'  /* allocation rectangle after the conatiner_border_width and the width of the shadow border
  GDKRECTANGLE .internal_allocation
'  /* rows
  XLONG .rows
  XLONG .row_height
  XLONG .row_list
  XLONG .row_list_end
'  /* columns
  XLONG .columns
  GDKRECTANGLE .column_title_area
  XLONG .title_window
'  /* dynamicly allocated array of column structures
  XLONG .column
'  /* the scrolling window and its height and width to make things a little speedier
  XLONG .clist_window
  XLONG .clist_window_width
  XLONG .clist_window_height
'  /* offsets for scrolling
  XLONG .hoffset
  XLONG .voffset
'  /* border shadow style
  XLONG .shadow_type
'  /* the list's selection mode (gtkenums.h)
  XLONG .selection_mode
'  /* list of selected rows
  XLONG .selection
  XLONG .selection_end
  XLONG .undo_selection
  XLONG .undo_unselection
  XLONG .undo_anchor
'  /* mouse buttons
  UBYTE .button_actions[5]
  UBYTE .drag_button
'  /* dnd
  GTKCLISTCELLINFO .click_cell
'  /* scroll adjustments
  XLONG .hadjustment
  XLONG .vadjustment
'  /* xor GC for the vertical drag line
  XLONG .xor_gc
'  /* gc for drawing unselected cells
  XLONG .fg_gc
  XLONG .bg_gc
'  /* cursor used to indicate dragging
  XLONG .cursor_drag
'  /* the current x-pixel location of the xor-drag line
  XLONG .x_drag
'  /* focus handling
  XLONG .focus_row
  XLONG .focus_header_column
'  /* dragging the selection
  XLONG .anchor
  XLONG .anchor_state
  XLONG .drag_pos
  XLONG .htimer
  XLONG .vtimer
  XLONG .sort_type
  XLONG .compare
  XLONG .sort_column
  XLONG .drag_highlight_row
  XLONG .drag_highlight_pos
END TYPE

TYPE GTKCLISTCOLUMN
  XLONG .title
  GDKRECTANGLE .area
  XLONG .button
  XLONG .window
  XLONG .width
  XLONG .min_width
  XLONG .max_width
  XLONG .justification
  ULONG .visible
  ULONG .width_set
  ULONG .resizeable
  ULONG .auto_resize
  ULONG .button_passive
END TYPE

TYPE GTKCLISTROW
  XLONG .cell
  XLONG .state
  GDKCOLOR .foreground
  GDKCOLOR .background
  XLONG .style
  XLONG .data
  XLONG .destroy
  ULONG .fg_set
  ULONG .bg_set
  ULONG .selectable
END TYPE

' Cell Structures
TYPE GTKCELLTEXT
  XLONG .type
  SSHORT .vertical
  SSHORT .horizontal
  XLONG .style
  XLONG .text
END TYPE

TYPE GTKCELLPIXMAP
  XLONG .type
  SSHORT .vertical
  SSHORT .horizontal
  XLONG .style
  XLONG .pixmap
  XLONG .mask
END TYPE

TYPE GTKCELLPIXTEXT
  XLONG .type
  SSHORT .vertical
  SSHORT .horizontal
  XLONG .style
  XLONG .text
  UBYTE .spacing
  XLONG .pixmap
  XLONG .mask
END TYPE

TYPE GTKCELLWIDGET
  XLONG .type
  SSHORT .vertical
  SSHORT .horizontal
  XLONG .style
  XLONG .widget
END TYPE

TYPE PMGTKCELL
  XLONG .pixmap
  XLONG .mask
END TYPE

TYPE PTGTKCELL
  XLONG .text
  UBYTE .spacing
  XLONG .pixmap
  XLONG .mask
END TYPE

TYPE GTKCELL
  XLONG .type
  SSHORT .vertical
  SSHORT .horizontal
  XLONG .style
  UNION
    XLONG .text
		PMGTKCELL	.pm
		PTGTKCELL	.pt
    XLONG .widget
	END UNION
END TYPE

