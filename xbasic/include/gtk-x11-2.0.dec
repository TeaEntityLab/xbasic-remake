EXTERNAL CFUNCTION XLONG gtk_type_new (XLONG)
'
EXTERNAL CFUNCTION ULONG gtk_identifier_get_type ()

' --- typedefs ---
' here we come with some necessary forward declarations for structures and
' * provide some fundamental function signatures

' GtkArg, used to hold differently typed values
TYPE SIGNAL_DATA
      XLONG .f
      XLONG .d
END TYPE

TYPE GTKARG
  XLONG .type
  XLONG .name
'  /* this union only defines the required storage types for
'   * the possibile values, thus there is no gint enum_data field,
'   * because that would just be a mere alias for gint int_data.
'   * use the GTK_VALUE_*() and GTK_RETLOC_*() macros to access
'   * the discrete memebers.
'
  UNION
'    /* flat values
    SBYTE .char_data
    UBYTE .uchar_data
    XLONG .bool_data
    XLONG .int_data
    ULONG .uint_data
    XLONG .long_data
    ULONG .ulong_data
    SINGLE .float_data
    DOUBLE .double_data
    XLONG .string_data
    XLONG .object_data
    XLONG .pointer_data
'    /* structured values
		SIGNAL_DATA .signal_data
  END UNION
END TYPE

' type registration, it is recommended to use
' * g_type_register_static() or
' * g_type_register_dynamic() instead
'
TYPE GTKTYPEINFO
  XLONG .type_name
  ULONG .object_size
  ULONG .class_size
  XLONG .class_init_func
  XLONG .object_init_func
  XLONG .reserved_1
  XLONG .reserved_2
  XLONG .base_class_init_func
END TYPE

EXTERNAL CFUNCTION XLONG gtk_type_class	(XLONG)

