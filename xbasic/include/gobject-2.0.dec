'/* --- prototypes --- */
EXTERNAL CFUNCTION XLONG g_closure_ref				(XLONG)
EXTERNAL CFUNCTION g_closure_sink			(XLONG)
EXTERNAL CFUNCTION g_closure_unref			(XLONG)
'/* intimidating */
EXTERNAL CFUNCTION XLONG g_closure_new_simple			(ULONG,	XLONG)
EXTERNAL CFUNCTION g_closure_add_finalize_notifier	(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION g_closure_remove_finalize_notifier	(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION g_closure_add_invalidate_notifier	(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION g_closure_remove_invalidate_notifier	(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION g_closure_add_marshal_guards		(XLONG,	XLONG,	XLONG,	XLONG,	XLONG)
