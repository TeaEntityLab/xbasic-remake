TYPE GTYPE = ULONG

'/* Basic Type TYPEures
TYPE GTYPECLASS
'  /*< private >*/
  GTYPE .g_type
END TYPE

TYPE GTYPEINSTANCE
'  /*< private >*/
  XLONG .g_class
END TYPE

TYPE GTYPEINTERFACE
'  /*< private >*/
  GTYPE .g_type         '/* iface type */
  GTYPE .g_instance_type
END TYPE

TYPE GTYPEQUERY
  GTYPE		.type
  XLONG .type_name
  ULONG .class_size
  ULONG .instance_size
END TYPE


'/* Casts, checks and accessors for structured types
' * usage of these macros is reserved to type implementations only

