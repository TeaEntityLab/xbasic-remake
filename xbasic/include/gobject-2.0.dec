TYPE GPARAMSPECCHAR
  GPARAMSPEC   .parent_instance 
  SBYTE .minimum 
  SBYTE .maximum 
  SBYTE .default_value 
END TYPE

TYPE GPARAMSPECUCHAR
  GPARAMSPEC   .parent_instance 
  UBYTE .minimum 
  UBYTE .maximum 
  UBYTE .default_value 
END TYPE

TYPE GPARAMSPECBOOLEAN
  GPARAMSPEC   .parent_instance 
  XLONG .default_value 
END TYPE

TYPE GPARAMSPECINT
  GPARAMSPEC   .parent_instance 
  XLONG .minimum 
  XLONG .maximum 
  XLONG .default_value 
END TYPE

TYPE GPARAMSPECUINT
  GPARAMSPEC   .parent_instance 
  XLONG .minimum 
  XLONG .maximum 
  XLONG .default_value 
END TYPE

TYPE GPARAMSPECLONG
  GPARAMSPEC   .parent_instance 
  ULONG .minimum 
  ULONG .maximum 
  ULONG .default_value 
END TYPE

TYPE GPARAMSPECULONG
  GPARAMSPEC   .parent_instance 
  ULONG .minimum 
  ULONG .maximum 
  ULONG .default_value 
END TYPE

TYPE GPARAMSPECINT64
  GPARAMSPEC   .parent_instance 
  DOUBLE .minimum 
  DOUBLE .maximum 
  DOUBLE .default_value 
END TYPE

TYPE GPARAMSPECUINT64
  GPARAMSPEC   .parent_instance 
  DOUBLE .minimum 
  DOUBLE .maximum 
  DOUBLE .default_value 
END TYPE

TYPE GPARAMSPECUNICHAR
  GPARAMSPEC   .parent_instance 
  ULONG .default_value 
END TYPE

TYPE GPARAMSPECENUM
  GPARAMSPEC   .parent_instance 
  XLONG .enum_class 
  XLONG .default_value 
END TYPE

TYPE GPARAMSPECFLAGS
  GPARAMSPEC   .parent_instance 
  XLONG .flags_class 
  ULONG .default_value 
END TYPE

TYPE GPARAMSPECFLOAT
  GPARAMSPEC   .parent_instance 
  SINGLE .minimum 
  SINGLE .maximum 
  SINGLE .default_value 
  SINGLE .epsilon 
END TYPE

TYPE GPARAMSPECDOUBLE
  GPARAMSPEC   .parent_instance 
  DOUBLE .minimum 
  DOUBLE .maximum 
  DOUBLE .default_value 
  DOUBLE .epsilon 
END TYPE

TYPE GPARAMSPECSTRING
  GPARAMSPEC   .parent_instance 
  XLONG .default_value 
  XLONG .cset_first 
  XLONG .cset_nth 
  SBYTE .substitutor 
  ULONG .flags
'  ULONG .null_fold_if_empty ': 1
'  ULONG .ensure_non_null ': 1
END TYPE

TYPE GPARAMSPECPARAM
  GPARAMSPEC   .parent_instance 
END TYPE

TYPE GPARAMSPECBOXED
  GPARAMSPEC   .parent_instance 
END TYPE

TYPE GPARAMSPECPOINTER
  GPARAMSPEC   .parent_instance 
END TYPE

TYPE GPARAMSPECVALUEARRAY
  GPARAMSPEC   .parent_instance 
  XLONG .element_spec 
  ULONG .fixed_n_elements 
END TYPE

TYPE GPARAMSPECOBJECT
  GPARAMSPEC   .parent_instance 
END TYPE

TYPE GPARAMSPECOVERRIDE
'  /*< private >*/
  GPARAMSPEC   .parent_instance 
  XLONG .overridden 
END TYPE

TYPE GPARAMSPECGTYPE
  GPARAMSPEC   .parent_instance 
  ULONG .is_a_type 
END TYPE

