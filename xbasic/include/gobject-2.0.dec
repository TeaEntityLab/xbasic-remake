'#########################
'########  gclosure
'#########################

'/* --- TYPEures --- */
TYPE GCLOSURENOTIFYDATA
  XLONG .data
  XLONG .notify
END TYPE

TYPE GCLOSURE
'  /*< private >*/
   ULONG .flags
'  ULONG .ref_count ': 15;
'  ULONG .meta_marshal ': 1;
'  ULONG .n_guards ': 1;
'  ULONG .n_fnotifiers ': 2;	/* finalization notifiers */
'  ULONG .n_inotifiers ': 8;	/* invalidation notifiers */
'  ULONG .in_inotify ': 1;
'  ULONG .floating ': 1;
'  /*< protected >*/
'  ULONG .derivative_flag ': 1;
'  /*< public >*/
'  ULONG .in_marshal ': 1;
'  ULONG .is_invalid ': 1;
'  /*< private >*/
	XLONG .marshal
'	/*< protected >*/	
	XLONG .data
'  /*< private >*/	
	XLONG .notifiers
'  /* invariants/constrains:
'   * - ->marshal and ->data are _invalid_ as soon as ->is_invalid==TRUE
'   * - invocation of all inotifiers occours prior to fnotifiers
'   * - order of inotifiers is random
'   *   inotifiers may _not_ free/invalidate parameter values (e.g. ->data)
'   * - order of fnotifiers is random
'   * - each notifier may only be removed before or during its invocation
'   * - reference counting may only happen prior to fnotify invocation
'   *   (in that sense, fnotifiers are really finalization handlers)
END TYPE

'/* closure for C function calls, callback() is the user function
TYPE GCCLOSURE
  GCLOSURE	.closure
  XLONG	.callback
END TYPE

'/* --- prototypes --- */
EXTERNAL CFUNCTION XLONG g_cclosure_new			(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_cclosure_new_swap			(XLONG,	XLONG,	XLONG)
