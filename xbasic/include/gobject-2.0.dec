TYPE GTYPEINFO
'  /* interface types, classed types, instantiated types */
  USHORT .class_size
  XLONG .base_init
  XLONG .base_finalize
'  /* interface types, classed types, instantiated types */
  XLONG .class_init
  XLONG .class_finalize
  XLONG .class_data
'  /* instantiated types */
  USHORT .instance_size
  USHORT .n_preallocs
  XLONG .instance_init
'  /* value handling */
  XLONG .value_table
END TYPE

TYPE GTYPEFUNDAMENTALINFO
