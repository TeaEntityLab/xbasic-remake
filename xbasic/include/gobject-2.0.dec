'/* --- flags --- */
$$G_PARAM_READABLE            = 1
$$G_PARAM_WRITABLE            = 2
$$G_PARAM_CONSTRUCT	      = 4
$$G_PARAM_CONSTRUCT_ONLY      = 8
$$G_PARAM_LAX_VALIDATION      = 16
$$G_PARAM_STATIC_NAME	      = 32
$$G_PARAM_PRIVATE	      = $$G_PARAM_STATIC_NAME
$$G_PARAM_STATIC_NICK	      = 64
$$G_PARAM_STATIC_BLURB	      = 128
'} GParamFlags;
$$G_PARAM_MASK	=	0x000000ff
'/* bits in the range 0xffffff00 are reserved for 3rd party usage */
$$G_PARAM_USER_SHIFT	= 8

'/* --- typedefs & structures --- */
TYPE GPARAMSPEC
  GTYPEINSTANCE  .g_type_instance
  XLONG .name
  XLONG .flags
  ULONG .value_type
  ULONG .owner_type	'/* class or interface using this property */
'  /*< private >*/
  XLONG .nick
  XLONG .blurb
  XLONG .qdata
  ULONG .ref_count
  ULONG .param_id	'/* sort-criteria */
END TYPE

TYPE GPARAMETER '/* auxillary structure for _setv() variants */
  XLONG .name
  GVALUE .value
END TYPE

