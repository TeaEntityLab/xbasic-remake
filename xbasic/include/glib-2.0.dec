EXTERNAL CFUNCTION XLONG g_array_prepend_vals(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_array_insert_vals (XLONG,	XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_array_set_size  (XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_array_remove_index(XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_array_remove_index_fast (XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_array_remove_range(XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION g_array_sort(XLONG,	XLONG)
EXTERNAL CFUNCTION g_array_sort_with_data    (XLONG,	XLONG,	XLONG)
'/* Resizable pointer array.  This interface is much less complicated
' * than the above.  Add appends a pointer.  Remove fills any cleared
' * spot and shortens the array. remove_fast will again distort order.
EXTERNAL CFUNCTION XLONG g_ptr_array_new  ()
EXTERNAL CFUNCTION XLONG g_ptr_array_sized_new  (XLONG)
EXTERNAL CFUNCTION XLONG g_ptr_array_free (XLONG,		XLONG)
