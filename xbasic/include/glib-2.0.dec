TYPE GHOOKLIST
  ULONG .seq_id
  ULONG .flags
'  ULONG .hook_size ': 16;
'  ULONG .is_setup ': 1;
  XLONG .hooks
  XLONG .dummy3
  XLONG .finalize_hook
  XLONG .dummy[2]
END TYPE

TYPE GHOOK
  XLONG .data
  XLONG .next
  XLONG .prev
  ULONG .ref_count
  ULONG .hook_id
  ULONG .flags
  XLONG .func
  XLONG .destroy
END TYPE

