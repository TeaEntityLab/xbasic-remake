EXTERNAL CFUNCTION XLONG g_ptr_array_remove_fast(XLONG,		XLONG)
EXTERNAL CFUNCTION g_ptr_array_remove_range (XLONG,		XLONG,		XLONG)
EXTERNAL CFUNCTION g_ptr_array_add  (XLONG,		XLONG)
EXTERNAL CFUNCTION g_ptr_array_sort (XLONG,		XLONG)
EXTERNAL CFUNCTION g_ptr_array_sort_with_data     (XLONG,		XLONG,		XLONG)
EXTERNAL CFUNCTION g_ptr_array_foreach    (XLONG,		XLONG,		XLONG)
'/* Byte arrays, an array of guint8.  Implemented as a GArray,
