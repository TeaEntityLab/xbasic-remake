'#########################
'########  gwin32
'#########################

'/* For some POSIX functions that are not provided by the MS runtime,
' * we provide emulation functions in glib, which are prefixed with
' * g_win32_. Or that was the idea at some time, but there is just one
' * of those:
EXTERNAL CFUNCTION SLONG g_win32_ftruncate	(SLONG,	ULONG)
'/* The MS setlocale uses locale names of the form "English_United
' * States.1252" etc. We want the Unixish standard form "en", "zh_TW"
' * etc. This function gets the current thread locale from Windows and
' * returns it as a string of the above form for use in forming file
' * names etc. The returned string should be deallocated with g_free().
EXTERNAL CFUNCTION XLONG g_win32_getlocale  ()
'/* Translate a Win32 error code (as returned by GetLastError()) into
' * the corresponding message. The returned string should be deallocated
' * with g_free().
EXTERNAL CFUNCTION XLONG g_win32_error_message (SLONG)
EXTERNAL CFUNCTION XLONG g_win32_get_package_installation_directory_utf8 (XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_win32_get_package_installation_subdirectory_utf8 (XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_win32_get_package_installation_directory_of_module (XLONG)
EXTERNAL CFUNCTION XLONG g_win32_get_windows_version ()
EXTERNAL CFUNCTION XLONG g_win32_locale_filename_from_utf8 (XLONG)

