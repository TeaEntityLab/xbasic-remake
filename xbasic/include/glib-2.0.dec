EXTERNAL CFUNCTION XLONG g_checksum_copy       (XLONG)
EXTERNAL CFUNCTION g_checksum_free       (XLONG)
EXTERNAL CFUNCTION g_checksum_update     (XLONG,XLONG,XLONG)
