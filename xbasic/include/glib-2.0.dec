'/* enum used to specify order of appearance in parsed date strings */
$$G_DATE_DAY   = 0
$$G_DATE_MONTH = 1
$$G_DATE_YEAR  = 2
'/* actual week and month values */
$$G_DATE_BAD_WEEKDAY  = 0
$$G_DATE_MONDAY       = 1
$$G_DATE_TUESDAY      = 2
$$G_DATE_WEDNESDAY    = 3
$$G_DATE_THURSDAY     = 4
$$G_DATE_FRIDAY       = 5
$$G_DATE_SATURDAY     = 6
$$G_DATE_SUNDAY       = 7

$$G_DATE_BAD_MONTH = 0
$$G_DATE_JANUARY   = 1
$$G_DATE_FEBRUARY  = 2
$$G_DATE_MARCH     = 3
$$G_DATE_APRIL     = 4
$$G_DATE_MAY       = 5
$$G_DATE_JUNE      = 6
$$G_DATE_JULY      = 7
$$G_DATE_AUGUST    = 8
$$G_DATE_SEPTEMBER = 9
$$G_DATE_OCTOBER   = 10
$$G_DATE_NOVEMBER  = 11
$$G_DATE_DECEMBER  = 12

'/* Note: directly manipulating structs is generally a bad idea, but
' * in this case it's an *incredibly* bad idea, because all or part
' * of this struct can be invalid at any given time. Use the functions,
' * or you will get hosed, I promise.
TYPE GDATE
  ULONG .julian_days ': 32; /* julian days representation - we use a
                           '*  bitfield hoping that 64 bit platforms
                           '*  will pack this whole struct in one big int
  ULONG .flags
'  ULONG .julian ': 1;    /* julian is valid */
'  ULONG .dmy    ': 1;    /* dmy is valid */
'  /* DMY representation */
'  ULONG .day    ': 6;
'  ULONG .month  ': 4;
'  ULONG .year   ': 16;
END TYPE

'/* g_date_new() returns an invalid date, you then have to _set() stuff
' * to get a usable object. You can also allocate a GDate statically,
' * then call g_date_clear() to initialize.
EXTERNAL CFUNCTION XLONG g_date_new ()
EXTERNAL CFUNCTION XLONG g_date_new_dmy (XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG g_date_new_julian (ULONG)
EXTERNAL CFUNCTION g_date_free(XLONG)

'/* check g_date_valid() after doing an operation that might fail, like
' * _parse.  Almost all g_date operations are undefined on invalid
' * dates (the exceptions are the mutators, since you need those to
' * return to validity).
EXTERNAL CFUNCTION XLONG g_date_valid   (XLONG)
EXTERNAL CFUNCTION XLONG g_date_valid_day  (XLONG)
EXTERNAL CFUNCTION XLONG g_date_valid_month(XLONG)
EXTERNAL CFUNCTION XLONG g_date_valid_year (XLONG)
EXTERNAL CFUNCTION XLONG g_date_valid_weekday (XLONG)
EXTERNAL CFUNCTION XLONG g_date_valid_julian  (XLONG)
EXTERNAL CFUNCTION XLONG g_date_valid_dmy  (XLONG, XLONG, XLONG)

EXTERNAL CFUNCTION XLONG g_date_get_weekday(XLONG)
EXTERNAL CFUNCTION XLONG g_date_get_month  (XLONG)
EXTERNAL CFUNCTION XLONG g_date_get_year(XLONG)
EXTERNAL CFUNCTION XLONG g_date_get_day (XLONG)
EXTERNAL CFUNCTION ULONG g_date_get_julian (XLONG)
EXTERNAL CFUNCTION ULONG g_date_get_day_of_year       (XLONG)
'/* First monday/sunday is the start of week 1; if we haven't reached
' * that day, return 0. These are not ISO weeks of the year; that
' * routine needs to be added.
' * these functions return the number of weeks, starting on the
' * corrsponding day

EXTERNAL CFUNCTION ULONG g_date_get_monday_week_of_year (XLONG)
EXTERNAL CFUNCTION ULONG g_date_get_sunday_week_of_year (XLONG)
EXTERNAL CFUNCTION ULONG g_date_get_iso8601_week_of_year (XLONG)

'/* If you create a static date struct you need to clear it to get it
' * in a sane state before use. You can clear a whole array at
' * once with the ndates argument.

EXTERNAL CFUNCTION g_date_clear   (XLONG, ULONG)

'/* The parse routine is meant for dates typed in by a user, so it
' * permits many formats but tries to catch common typos. If your data
' * needs to be strictly validated, it is not an appropriate function.
EXTERNAL CFUNCTION g_date_set_parse  (XLONG, XLONG)
EXTERNAL CFUNCTION g_date_set_time_t (XLONG,	XLONG)
EXTERNAL CFUNCTION g_date_set_time_val  (XLONG,	XLONG)
EXTERNAL CFUNCTION g_date_set_time(XLONG, XLONG)
EXTERNAL CFUNCTION g_date_set_month  (XLONG, XLONG)
EXTERNAL CFUNCTION g_date_set_day (XLONG, XLONG)
EXTERNAL CFUNCTION g_date_set_year(XLONG, XLONG)
EXTERNAL CFUNCTION g_date_set_dmy (XLONG, XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION g_date_set_julian (XLONG, XLONG)
EXTERNAL CFUNCTION XLONG g_date_is_first_of_month     (XLONG)
EXTERNAL CFUNCTION XLONG g_date_is_last_of_month      (XLONG)

'/* To go forward by some number of weeks just go forward weeks*7 days */
EXTERNAL CFUNCTION g_date_add_days(XLONG, ULONG)
EXTERNAL CFUNCTION g_date_subtract_days (XLONG, ULONG)

'/* If you add/sub months while day > 28, the day might change' */
EXTERNAL CFUNCTION g_date_add_months (XLONG, ULONG)
EXTERNAL CFUNCTION g_date_subtract_months       (XLONG, ULONG)

'/* If it's feb 29, changing years can move you to the 28th */
EXTERNAL CFUNCTION g_date_add_years  (XLONG, ULONG)
EXTERNAL CFUNCTION g_date_subtract_years(XLONG, ULONG)
EXTERNAL CFUNCTION XLONG g_date_is_leap_year  (XLONG)
EXTERNAL CFUNCTION UBYTE g_date_get_days_in_month     (XLONG, XLONG)
EXTERNAL CFUNCTION UBYTE g_date_get_monday_weeks_in_year  (XLONG)
EXTERNAL CFUNCTION UBYTE g_date_get_sunday_weeks_in_year  (XLONG)

'/* Returns the number of days between the two dates.  If date2 comes
'   before date1, a negative value is return. */
