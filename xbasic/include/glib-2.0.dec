TYPE GTUPLES
  ULONG .len
END TYPE
'/* GRelation
' *
' * Indexed Relations.  Imagine a really simple table in a
' * database.  Relations are not ordered.  This data type is meant for
' * maintaining a N-way mapping.
' *
' * g_relation_new() creates a relation with FIELDS fields
' *
' * g_relation_destroy() frees all resources
' * g_tuples_destroy() frees the result of g_relation_select()
' *
' * g_relation_index() indexes relation FIELD with the provided
' *   equality and hash functions.  this must be done before any
' *   calls to insert are made.
' *
' * g_relation_insert() inserts a new tuple.  you are expected to
' *   provide the right number of fields.
' *
' * g_relation_delete() deletes all relations with KEY in FIELD
' * g_relation_select() returns ...
' * g_relation_count() counts ...
EXTERNAL CFUNCTION XLONG g_relation_new     (XLONG)
EXTERNAL CFUNCTION g_relation_destroy (XLONG)
EXTERNAL CFUNCTION g_relation_index   (XLONG, XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION g_relation_insert  (XLONG, ...)
EXTERNAL CFUNCTION XLONG g_relation_delete  (XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG g_relation_select  (XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG g_relation_count   (XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG g_relation_exists  (XLONG, ...)
EXTERNAL CFUNCTION g_relation_print   (XLONG)
EXTERNAL CFUNCTION g_tuples_destroy   (XLONG)
EXTERNAL CFUNCTION XLONG g_tuples_index     (XLONG, XLONG, XLONG)

