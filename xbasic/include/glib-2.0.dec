'#########################
'########  gscanner
'#########################

'/* GScanner: Flexible lexical scanner for general purpose.

'/* Character sets */
$$G_CSET_A_2_Z$		= "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
$$G_CSET_a_2_z$		= "abcdefghijklmnopqrstuvwxyz"
$$G_CSET_DIGITS$	= "0123456789"
$$G_CSET_LATINC$	= "\300\301\302\303\304\305\306\307\310\311\312\313\314\315\316\317\320\321\322\323\324\325\326\330\331\332\333\334\335\336"
$$G_CSET_LATINS$	= "\337\340\341\342\343\344\345\346\347\350\351\352\353\354\355\356\357\360\361\362\363\364\365\366\370\371\372\373\374\375\376\377"

'/* Error types */
$$G_ERR_UNKNOWN = 0
$$G_ERR_UNEXP_EOF = 1
$$G_ERR_UNEXP_EOF_IN_STRING = 2
$$G_ERR_UNEXP_EOF_IN_COMMENT = 3
$$G_ERR_NON_DIGIT_IN_CONST = 4
$$G_ERR_DIGIT_RADIX = 5
$$G_ERR_FLOAT_RADIX = 6
$$G_ERR_FLOAT_MALFORMED = 7

'/* Token types */
$$G_TOKEN_EOF			=   0

$$G_TOKEN_LEFT_PAREN$		= "("
$$G_TOKEN_RIGHT_PAREN$	= ")"
$$G_TOKEN_LEFT_CURLY$		= "{"
$$G_TOKEN_RIGHT_CURLY$	= "}"
$$G_TOKEN_LEFT_BRACE$		= "["
$$G_TOKEN_RIGHT_BRACE$	= "]"
$$G_TOKEN_EQUAL_SIGN$		= "="
$$G_TOKEN_COMMA$				= ","

$$G_TOKEN_NONE			= 256

$$G_TOKEN_ERROR = 0

$$G_TOKEN_CHAR = 0
$$G_TOKEN_BINARY = 1
$$G_TOKEN_OCTAL = 2
$$G_TOKEN_INT = 3
$$G_TOKEN_HEX = 4
$$G_TOKEN_FLOAT = 5
$$G_TOKEN_STRING = 6

$$G_TOKEN_SYMBOL = 0
$$G_TOKEN_IDENTIFIER = 1
$$G_TOKEN_IDENTIFIER_NULL = 2

$$G_TOKEN_COMMENT_SINGLE = 0
$$G_TOKEN_COMMENT_MULTI = 1
$$G_TOKEN_LAST = 2

TYPE GTOKENVALUE
	UNION
		XLONG .v_symbol
		XLONG .v_identifier
		ULONG .v_binary
		ULONG .v_octal
		ULONG .v_int
		DOUBLE .v_int64
		DOUBLE .v_float
		ULONG .v_hex
		XLONG .v_string
		XLONG .v_comment
		UBYTE	.v_char
		ULONG .v_error
	END UNION
END TYPE

TYPE	GSCANNERCONFIG
'  /* Character sets
  XLONG .set_skip_characters		'/* default: " \t\n" */
  XLONG .cset_identifier_first
  XLONG .cset_identifier_nth
  XLONG .cpair_comment_single		'/* default: "#\n" */
'  /* Should symbol lookup work case sensitive?
   ULONG .flags
'  ULONG .case_sensitive ': 1;
'  /* Boolean values to be adjusted "on the fly"
'   * to configure scanning behaviour.
'  ULONG .skip_comment_multi ': 1;		/* C like comment */
'  ULONG .skip_comment_single ': 1;	/* single line comment */
'  ULONG .scan_comment_multi ': 1;		/* scan multi line comments? */
'  ULONG .scan_identifier ': 1;
'  ULONG .scan_identifier_1char ': 1;
'  ULONG .scan_identifier_NULL ': 1;
'  ULONG .scan_symbols ': 1;
'  ULONG .scan_binary ': 1;
'  ULONG .scan_octal ': 1;
'  ULONG .scan_float ': 1;
'  ULONG .scan_hex ': 1;			/* `0x0ff0' */
'  ULONG .scan_hex_dollar ': 1;		/* `$0ff0' */
'  ULONG .scan_string_sq ': 1;		/* string: 'anything' */
'  ULONG .scan_string_dq ': 1;		/* string: "\\-escapes!\n" */
'  ULONG .numbers_2_int ': 1;		/* bin, octal, hex => int */
'  ULONG .int_2_float ': 1;		/* int => G_TOKEN_FLOAT? */
'  ULONG .identifier_2_string ': 1;
'  ULONG .char_2_token ': 1;		/* return G_TOKEN_CHAR? */
'  ULONG .symbol_2_token ': 1;
'  ULONG .scope_0_fallback ': 1;		/* try scope 0 on lookups? */
'  ULONG .store_int64 ': 1; 		/* use value.v_int64 rather than v_int */
  ULONG .padding_dummy
END TYPE

TYPE	GSCANNER
'  /* unused fields */
  XLONG .user_data
  ULONG .max_parse_errors
'  /* g_scanner_error() increments this field */
  ULONG .parse_errors
'  /* name of input stream, featured by the default message handler */
  XLONG .input_name
'  /* quarked data */
  XLONG .qdata
'  /* link into the scanner configuration */
  XLONG .config
'  /* fields filled in after g_scanner_get_next_token() */
  XLONG .token
  XLONG .value
  ULONG .line
  ULONG .position
'  /* fields filled in after g_scanner_peek_next_token() */
  XLONG .next_token
  XLONG .next_value
  XLONG .next_line
  XLONG .next_position
'  /* to be considered private */
  XLONG .symbol_table
  XLONG .input_fd
  XLONG .text
  XLONG .text_end
  XLONG .buffer
  ULONG .scope_id
  '/* handler function for _warn and _error */
  XLONG .msg_handler
END TYPE

