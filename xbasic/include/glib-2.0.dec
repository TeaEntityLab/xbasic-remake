TYPE GPTRARRAY
	XLONG .pdata
  ULONG .len
END TYPE

'/* Resizable arrays. remove fills any cleared spot and shortens the
' * array, while preserving the order. remove_fast will distort the
' * order by moving the last element to the position of the removed.
EXTERNAL CFUNCTION XLONG g_array_new (XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_array_sized_new (XLONG,	XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG g_array_free(XLONG,	XLONG)
