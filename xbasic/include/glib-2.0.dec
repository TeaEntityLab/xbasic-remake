'#########################
'########  gthreadpool
'#########################

'/* Thread Pools
'/* The real GThreadPool is bigger, so you may only create a thread
' * pool with the constructor function */
TYPE GTHREADPOOL
  XLONG .func
  XLONG .user_data
  SLONG .exclusive
END TYPE
'/* Get a thread pool with the function func, at most max_threads may
' * run at a time (max_threads == -1 means no limit), exclusive == TRUE
' * means, that the threads shouldn't be shared and that they will be
' * prestarted (otherwise they are started as needed) user_data is the
' * 2nd argument to the func */
EXTERNAL CFUNCTION XLONG g_thread_pool_new             (XLONG, XLONG, XLONG, SLONG, XLONG)
'/* Push new data into the thread pool. This task is assigned to a thread later
' * (when the maximal number of threads is reached for that pool) or now
' * (otherwise). If necessary a new thread will be started. The function
' * returns immediatly */
EXTERNAL CFUNCTION g_thread_pool_push            (XLONG, XLONG, XLONG)
'/* Set the number of threads, which can run concurrently for that pool, -1
' * means no limit. 0 means has the effect, that the pool won't process
' * requests until the limit is set higher again */
EXTERNAL CFUNCTION g_thread_pool_set_max_threads (XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG g_thread_pool_get_max_threads (XLONG)
'/* Get the number of threads assigned to that pool. This number doesn't
' * necessarily represent the number of working threads in that pool */
EXTERNAL CFUNCTION ULONG g_thread_pool_get_num_threads (XLONG)
'/* Get the number of unprocessed items in the pool */
EXTERNAL CFUNCTION ULONG g_thread_pool_unprocessed     (XLONG)
'/* Free the pool, immediate means, that all unprocessed items in the queue
' * wont be processed, wait means, that the function doesn't return immediatly,
' * but after all threads in the pool are ready processing items. immediate
' * does however not mean, that threads are killed. */
EXTERNAL CFUNCTION g_thread_pool_free            (XLONG, SLONG, SLONG)
'/* Set the maximal number of unused threads before threads will be stopped by
' * GLib, -1 means no limit */
EXTERNAL CFUNCTION g_thread_pool_set_max_unused_threads (XLONG)
EXTERNAL CFUNCTION XLONG g_thread_pool_get_max_unused_threads ()
EXTERNAL CFUNCTION ULONG g_thread_pool_get_num_unused_threads ()
'/* Stop all currently unused threads, but leave the limit untouched */
EXTERNAL CFUNCTION g_thread_pool_stop_unused_threads    ()
'/* Set sort function for priority threading */
EXTERNAL CFUNCTION g_thread_pool_set_sort_function      (XLONG,	XLONG,	XLONG)
'/* Set maximum time a thread can be idle in the pool before it is stopped */
EXTERNAL CFUNCTION g_thread_pool_set_max_idle_time      (ULONG)
EXTERNAL CFUNCTION ULONG g_thread_pool_get_max_idle_time      ()

'#########################
'########  gasyncqueue
'#########################

'/* Asyncronous Queues, can be used to communicate between threads */
'/* Get a new GAsyncQueue with the ref_count 1 */
EXTERNAL CFUNCTION XLONG g_async_queue_new                 ()
EXTERNAL CFUNCTION XLONG g_async_queue_new_full            (XLONG)
'/* Lock and unlock a GAsyncQueue. All functions lock the queue for
' * themselves, but in certain cirumstances you want to hold the lock longer,
' * thus you lock the queue, call the *_unlocked functions and unlock it again.
EXTERNAL CFUNCTION g_async_queue_lock                 (XLONG)
EXTERNAL CFUNCTION g_async_queue_unlock               (XLONG)
'/* Ref and unref the GAsyncQueue. */
EXTERNAL CFUNCTION XLONG g_async_queue_ref                  (XLONG)
EXTERNAL CFUNCTION g_async_queue_unref                (XLONG)
'/* You don't have to hold the lock for calling *_ref and *_unref anymore. */
EXTERNAL CFUNCTION g_async_queue_ref_unlocked         (XLONG)
EXTERNAL CFUNCTION g_async_queue_unref_and_unlock     (XLONG)
'/* Push data into the async queue. Must not be NULL. */
EXTERNAL CFUNCTION g_async_queue_push                 (XLONG,	XLONG)
EXTERNAL CFUNCTION g_async_queue_push_unlocked        (XLONG,	XLONG)
EXTERNAL CFUNCTION g_async_queue_push_sorted          (XLONG,	XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION g_async_queue_push_sorted_unlocked (XLONG,	XLONG,	XLONG,	XLONG)
'/* Pop data from the async queue. When no data is there, the thread is blocked
' * until data arrives.
EXTERNAL CFUNCTION XLONG     g_async_queue_pop                  (XLONG)
EXTERNAL CFUNCTION XLONG     g_async_queue_pop_unlocked         (XLONG)
'/* Try to pop data. NULL is returned in case of empty queue. */
EXTERNAL CFUNCTION XLONG     g_async_queue_try_pop              (XLONG)
EXTERNAL CFUNCTION XLONG     g_async_queue_try_pop_unlocked     (XLONG)
'/* Wait for data until at maximum until end_time is reached. NULL is returned
' * in case of empty queue.
EXTERNAL CFUNCTION XLONG     g_async_queue_timed_pop            (XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG     g_async_queue_timed_pop_unlocked   (XLONG,	XLONG)
'/* Return the length of the queue. Negative values mean that threads
' * are waiting, positve values mean that there are entries in the
' * queue. Actually this function returns the length of the queue minus
' * the number of waiting threads, g_async_queue_length == 0 could also
' * mean 'n' entries in the queue and 'n' thread waiting. Such can
' * happen due to locking of the queue or due to scheduling.
EXTERNAL CFUNCTION XLONG         g_async_queue_length               (XLONG)
EXTERNAL CFUNCTION XLONG         g_async_queue_length_unlocked      (XLONG)
EXTERNAL CFUNCTION g_async_queue_sort                 (XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION g_async_queue_sort_unlocked        (XLONG,	XLONG,	XLONG)

