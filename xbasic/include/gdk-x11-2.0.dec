'#########################
'########  gdkimage
'#########################

'/* Types of images.
' *   Normal: Normal X image type. These are slow as they involve passing
' *	     the entire image through the X connection each time a draw
' *	     request is required. On Win32, a bitmap.
' *   Shared: Shared memory X image type. These are fast as the X server
' *	     and the program actually use the same piece of memory. They
' *	     should be used with care though as there is the possibility
' *	     for both the X server and the program to be reading/writing
' *	     the image simultaneously and producing undesired results.
' *	     On Win32, also a bitmap.
$$GDK_IMAGE_NORMAL = 0
$$GDK_IMAGE_SHARED = 1
$$GDK_IMAGE_FASTEST = 2
' GdkImageType;

TYPE GDKIMAGE
  GOBJECT .parent_instance
'  /*< public >*/
  XLONG .type '/* read only. */
  XLONG .visual	    '/* read only. visual used to create the image */
  XLONG .byte_order '/* read only. */
  XLONG .width '/* read only. */
  XLONG .height '/* read only. */
  USHORT .depth '/* read only. */
  USHORT .bpp	        '/* read only. bytes per pixel */
  USHORT .bpl	        '/* read only. bytes per line */
  USHORT .bits_per_pixel '/* read only. bits per pixel */
  XLONG .mem
  XLONG .colormap '/* read only. */
'  /*< private >*/
  XLONG .windowing_data '/* read only. */
END TYPE

EXTERNAL CFUNCTION ULONG gdk_image_get_type   ()
EXTERNAL CFUNCTION XLONG gdk_image_new       (XLONG,	XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG gdk_image_get       (XLONG,	XLONG,	XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION XLONG gdk_image_ref       (XLONG)
EXTERNAL CFUNCTION gdk_image_unref     (XLONG)
EXTERNAL CFUNCTION gdk_image_put_pixel (XLONG,	XLONG,	XLONG,	ULONG)
EXTERNAL CFUNCTION ULONG gdk_image_get_pixel (XLONG,	XLONG,	XLONG)
EXTERNAL CFUNCTION gdk_image_set_colormap (XLONG, XLONG)
EXTERNAL CFUNCTION XLONG gdk_image_get_colormap (XLONG)
EXTERNAL CFUNCTION XLONG gdk_image_new_bitmap (XLONG,	XLONG,	XLONG,	XLONG)

