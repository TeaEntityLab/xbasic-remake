'#########################
'########  gdkgc
'#########################

$$GDK_CAP_NOT_LAST = 0
$$GDK_CAP_BUTT = 1
$$GDK_CAP_ROUND = 2
$$GDK_CAP_PROJECTING = 3
'
$$GDK_SOLID = 0
$$GDK_TILED = 1
$$GDK_STIPPLED = 2
$$GDK_OPAQUE_STIPPLED = 3

' GdkFill;
'/* GC function types.
' *   Copy: Overwrites destination pixels with the source pixels.
' *   Invert: Inverts the destination pixels.
' *   Xor: Xor's the destination pixels with the source pixels.
' *   Clear: set pixels to 0
' *   And: source AND destination
' *   And Reverse: source AND (NOT destination)
' *   And Invert: (NOT source) AND destination
' *   Noop: destination
' *   Or: source OR destination
' *   Nor: (NOT source) AND (NOT destination)
' *   Equiv: (NOT source) XOR destination
' *   Xor Reverse: source OR (NOT destination)
' *   Copy Inverted: NOT source
' *   Xor Inverted: (NOT source) OR destination
' *   Nand: (NOT source) OR (NOT destination)
' *   Set: set pixels to 1
$$GDK_COPY = 0
$$GDK_INVERT = 1
$$GDK_XOR = 2
$$GDK_CLEAR = 3
$$GDK_AND = 4
$$GDK_AND_REVERSE = 5
$$GDK_AND_INVERT = 6
$$GDK_NOOP = 7
$$GDK_OR = 8
$$GDK_EQUIV = 9
$$GDK_OR_REVERSE = 10
$$GDK_COPY_INVERT = 11
$$GDK_OR_INVERT = 12
$$GDK_NAND = 13
$$GDK_NOR = 14
$$GDK_SET = 15
' GdkFunction;

$$GDK_JOIN_MITER = 0
$$GDK_JOIN_ROUND = 1
$$GDK_JOIN_BEVEL = 2

$$GDK_LINE_SOLID = 0
$$GDK_LINE_ON_OFF_DASH = 1
$$GDK_LINE_DOUBLE_DASH = 2

$$GDK_CLIP_BY_CHILDREN	= 0
$$GDK_INCLUDE_INFERIORS = 1
' GdkSubwindowMode;

$$GDK_GC_FOREGROUND    = 1
$$GDK_GC_BACKGROUND    = 2
$$GDK_GC_FONT	       = 4
$$GDK_GC_FUNCTION      = 8
$$GDK_GC_FILL	       = 16
$$GDK_GC_TILE	       = 32
$$GDK_GC_STIPPLE       = 64
$$GDK_GC_CLIP_MASK     = 128
$$GDK_GC_SUBWINDOW     = 256
$$GDK_GC_TS_X_ORIGIN   = 512
$$GDK_GC_TS_Y_ORIGIN   = 1024
$$GDK_GC_CLIP_X_ORIGIN = 2048
$$GDK_GC_CLIP_Y_ORIGIN = 4096
$$GDK_GC_EXPOSURES     = 8192
$$GDK_GC_LINE_WIDTH    = 16384
$$GDK_GC_LINE_STYLE    = 32768
$$GDK_GC_CAP_STYLE     = 65536
$$GDK_GC_JOIN_STYLE    = 131072
' GdkGCValuesMask;

TYPE GDKGCVALUES
  GDKCOLOR .foreground
  GDKCOLOR .background
  XLONG	   .font
  XLONG .function
  XLONG	    .fill
  XLONG	   .tile
  XLONG	   .stipple
  XLONG	   .clip_mask
  XLONG  .subwindow_mode
  XLONG		    .ts_x_origin
  XLONG		    .ts_y_origin
  XLONG		    .clip_x_origin
  XLONG		    .clip_y_origin
  XLONG		    .graphics_exposures
  XLONG		    .line_width
  XLONG 	    .line_style
  XLONG	    .cap_style
  XLONG	    .join_style
END TYPE

TYPE GDKGC
  GOBJECT .parent_instance
  XLONG	   .clip_x_origin
  XLONG	   .clip_y_origin
  XLONG	   .ts_x_origin
  XLONG	   .ts_y_origin
  XLONG	   .colormap
END TYPE

