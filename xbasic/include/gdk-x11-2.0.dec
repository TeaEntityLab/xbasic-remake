'#########################
'########  gdkcolor
'#########################

'/* The color type.
' *   A color consists of red, green and blue values in the
' *    range 0-65535 and a pixel value. The pixel value is highly
' *    dependent on the depth and colormap which this color will
' *    be used to draw into. Therefore, sharing colors between
' *    colormaps is a bad idea.
' */

TYPE GDKCOLOR
  ULONG .pixel
  USHORT .red
  USHORT .green
  USHORT .blue
END TYPE

EXTERNAL CFUNCTION XLONG gdk_colormap_alloc_color (XLONG, XLONG, XLONG, XLONG)

TYPE GDKCOLORMAP
'  /*< private >*/
  GOBJECT .parent_instance
'  /*< public >*/
  SLONG .size
  XLONG .colors
'  /*< private >*/
  XLONG .visual
  XLONG .windowing_data
END TYPE

