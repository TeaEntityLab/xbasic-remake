'#########################
'########  gdktypes
'#########################

$$GDK_LSB_FIRST = 0
$$GDK_MSB_FIRST = 1
'} GdkByteOrder;

$$GDK_SHIFT_MASK    = 1
$$GDK_LOCK_MASK	    = 2
$$GDK_CONTROL_MASK  = 4
$$GDK_MOD1_MASK	    = 8
$$GDK_MOD2_MASK	    = 16
$$GDK_MOD3_MASK	    = 32
$$GDK_MOD4_MASK	    = 64
$$GDK_MOD5_MASK	    = 128
$$GDK_BUTTON1_MASK  = 256
$$GDK_BUTTON2_MASK  = 512
$$GDK_BUTTON3_MASK  = 1024
$$GDK_BUTTON4_MASK  = 2048
$$GDK_BUTTON5_MASK  = 4096

'The next few modifiers are used by XKB, so we skip to the end.
'Bits 15 - 25 are currently unused. Bit 29 is used internally.

$$GDK_SUPER_MASK    = 67108864
$$GDK_HYPER_MASK    = 134217728
$$GDK_META_MASK     = 2684435456

$$GDK_RELEASE_MASK  = 1073741824

$$GDK_MODIFIER_MASK = 0x5c001fff

$$GDK_INPUT_READ       = 1
$$GDK_INPUT_WRITE      = 2
$$GDK_INPUT_EXCEPTION  = 4
'} GdkInputCondition;

$$GDK_OK	  = 0
$$GDK_ERROR	  = -1
$$GDK_ERROR_PARAM = -2
$$GDK_ERROR_FILE  = -3
$$GDK_ERROR_MEM	  = -4
'} GdkStatus;

'/* We define specific numeric values for these constants,
' * since old application code may depend on them matching the X values
' * We don't actually depend on the matchup ourselves.
' */
$$GDK_GRAB_SUCCESS         = 0
$$GDK_GRAB_ALREADY_GRABBED = 1
$$GDK_GRAB_INVALID_TIME    = 2
$$GDK_GRAB_NOT_VIEWABLE    = 3
$$GDK_GRAB_FROZEN          = 4
'} GdkGrabStatus;

TYPE GDKPOINT
  XLONG .x
  XLONG .y
END TYPE

TYPE GDKSEGMENT
  XLONG .x1
  XLONG .y1
  XLONG .x2
  XLONG .y2
END TYPE

TYPE GDKRECTANGLE
  XLONG .x
  XLONG .y
  XLONG .width
  XLONG .height
END TYPE

TYPE GDKSPAN
  XLONG .x
  XLONG .y
  XLONG .width
END TYPE

'#########################
'########  gdkevents
'#########################

$$GDK_FILTER_CONTINUE = 0	  '/* Event not handled, continue processesing */
$$GDK_FILTER_TRANSLATE = 1	  '/* Native event translated into a GDK event and stored in the "event" structure that was passed in */
$$GDK_FILTER_REMOVE = 2	  '/* Terminate processing, removing event */
'} GdkFilterReturn;

TYPE GDKEVENT
	UNION
		XLONG	.type
		XLONG	.any
		XLONG	.expose
		XLONG	.no_expose
		XLONG	.visibility
		XLONG	.motion
		XLONG	.button
		XLONG .scroll
		XLONG	.key
		XLONG	.crossing
		XLONG	.focus_change
		XLONG	.configure
		XLONG	.property
		XLONG	.selection
		XLONG .owner_change
		XLONG	.proximity
		XLONG	.client
		XLONG .dnd
		XLONG .window_state
		XLONG .setting
		XLONG .grab_broken
	END UNION
END TYPE

'/* Event types.
' *   Nothing: No event occurred.
' *   Delete: A window delete event was sent by the window manager.
' *	     The specified window should be deleted.
' *   Destroy: A window has been destroyed.
' *   Expose: Part of a window has been uncovered.
' *   NoExpose: Same as expose, but no expose event was generated.
' *   VisibilityNotify: A window has become fully/partially/not obscured.
' *   MotionNotify: The mouse has moved.
' *   ButtonPress: A mouse button was pressed.
' *   ButtonRelease: A mouse button was release.
' *   KeyPress: A key was pressed.
' *   KeyRelease: A key was released.
' *   EnterNotify: A window was entered.
' *   LeaveNotify: A window was exited.
' *   FocusChange: The focus window has changed. (The focus window gets
' *		  keyboard events).
' *   Resize: A window has been resized.
' *   Map: A window has been mapped. (It is now visible on the screen).
' *   Unmap: A window has been unmapped. (It is no longer visible on
' *	    the screen).
' *   Scroll: A mouse wheel was scrolled either up or down.

$$GDK_NOTHING		= -1
$$GDK_DELETE		= 0
$$GDK_DESTROY		= 1
$$GDK_EXPOSE		= 2
$$GDK_MOTION_NOTIFY	= 3
$$GDK_BUTTON_PRESS	= 4
$$GDK_2BUTTON_PRESS	= 5
$$GDK_3BUTTON_PRESS	= 6
$$GDK_BUTTON_RELEASE	= 7
$$GDK_KEY_PRESS		= 8
$$GDK_KEY_RELEASE	= 9
$$GDK_ENTER_NOTIFY	= 10
$$GDK_LEAVE_NOTIFY	= 11
$$GDK_FOCUS_CHANGE	= 12
$$GDK_CONFIGURE		= 13
$$GDK_MAP		= 14
$$GDK_UNMAP		= 15
$$GDK_PROPERTY_NOTIFY	= 16
$$GDK_SELECTION_CLEAR	= 17
$$GDK_SELECTION_REQUEST = 18
$$GDK_SELECTION_NOTIFY	= 19
$$GDK_PROXIMITY_IN	= 20
$$GDK_PROXIMITY_OUT	= 21
$$GDK_DRAG_ENTER        = 22
$$GDK_DRAG_LEAVE        = 23
$$GDK_DRAG_MOTION       = 24
$$GDK_DRAG_STATUS       = 25
$$GDK_DROP_START        = 26
$$GDK_DROP_FINISHED     = 27
$$GDK_CLIENT_EVENT	= 28
$$GDK_VISIBILITY_NOTIFY = 29
$$GDK_NO_EXPOSE		= 30
$$GDK_SCROLL            = 31
$$GDK_WINDOW_STATE      = 32
$$GDK_SETTING           = 33
$$GDK_OWNER_CHANGE      = 34
$$GDK_GRAB_BROKEN       = 35


'Event masks. (Used to select what types of events a window will receive).

$$GDK_EXPOSURE_MASK		= 2
$$GDK_POINTER_MOTION_MASK	= 4
$$GDK_POINTER_MOTION_HINT_MASK	= 8
$$GDK_BUTTON_MOTION_MASK	= 16
$$GDK_BUTTON1_MOTION_MASK	= 32
$$GDK_BUTTON2_MOTION_MASK	= 64
$$GDK_BUTTON3_MOTION_MASK	= 128
$$GDK_BUTTON_PRESS_MASK		= 256
$$GDK_BUTTON_RELEASE_MASK	= 512
$$GDK_KEY_PRESS_MASK		= 1024
$$GDK_KEY_RELEASE_MASK		= 2048
$$GDK_ENTER_NOTIFY_MASK		= 4096
$$GDK_LEAVE_NOTIFY_MASK		= 8192
$$GDK_FOCUS_CHANGE_MASK		= 16384
$$GDK_STRUCTURE_MASK		= 32768
$$GDK_PROPERTY_CHANGE_MASK	= 65536
$$GDK_VISIBILITY_NOTIFY_MASK	= 131072
$$GDK_PROXIMITY_IN_MASK		= 262144
$$GDK_PROXIMITY_OUT_MASK	= 524288
$$GDK_SUBSTRUCTURE_MASK		= 1048576
$$GDK_SCROLL_MASK         = 2097152
$$GDK_ALL_EVENTS_MASK		= 0x3FFFFE

$$GDK_VISIBILITY_UNOBSCURED = 0
$$GDK_VISIBILITY_PARTIAL = 1
$$GDK_VISIBILITY_FULLY_OBSCURED = 2

$$GDK_SCROLL_UP = 0
$$GDK_SCROLL_DOWN = 1
$$GDK_SCROLL_LEFT = 2
$$GDK_SCROLL_RIGHT = 3
'} GdkScrollDirection;

'/* Types of enter/leave notifications.
' *   Ancestor:
' *   Virtual:
' *   Inferior:
' *   Nonlinear:
' *   NonlinearVirtual:
' *   Unknown: An unknown type of enter/leave event occurred.
' */
'typedef enum
'{
$$GDK_NOTIFY_ANCESTOR		= 0
$$GDK_NOTIFY_VIRTUAL		= 1
$$GDK_NOTIFY_INFERIOR		= 2
$$GDK_NOTIFY_NONLINEAR		= 3
$$GDK_NOTIFY_NONLINEAR_VIRTUAL	= 4
$$GDK_NOTIFY_UNKNOWN		= 5
'} GdkNotifyType;

'/* Enter/leave event modes.
' *   NotifyNormal
' *   NotifyGrab
' *   NotifyUngrab
' */
$$GDK_CROSSING_NORMAL = 0
$$GDK_CROSSING_GRAB = 1
$$GDK_CROSSING_UNGRAB = 2
'} GdkCrossingMode;

$$GDK_PROPERTY_NEW_VALUE = 0
$$GDK_PROPERTY_DELETE = 1
'} GdkPropertyState;

$$GDK_WINDOW_STATE_WITHDRAWN  = 1
$$GDK_WINDOW_STATE_ICONIFIED  = 2
$$GDK_WINDOW_STATE_MAXIMIZED  = 4
$$GDK_WINDOW_STATE_STICKY     = 16
$$GDK_WINDOW_STATE_FULLSCREEN = 32
$$GDK_WINDOW_STATE_ABOVE      = 64
$$GDK_WINDOW_STATE_BELOW      = 128
'} GdkWindowState;

$$GDK_SETTING_ACTION_NEW = 0
$$GDK_SETTING_ACTION_CHANGED = 1
$$GDK_SETTING_ACTION_DELETED = 2
'} GdkSettingAction;

$$GDK_OWNER_CHANGE_NEW_OWNER = 0
$$GDK_OWNER_CHANGE_DESTROY = 1
$$GDK_OWNER_CHANGE_CLOSE = 2
'} GdkOwnerChange;

TYPE GDKEVENTANY
  XLONG .type
  XLONG .window
  SBYTE .send_event
END TYPE

TYPE GDKEVENTEXPOSE
  XLONG .type
  XLONG .window
  SBYTE .send_event
  GDKRECTANGLE .area
  XLONG .region
  SLONG .count '* If non-zero, how many more events follow.
END TYPE

TYPE GDKEVENTNOEXPOSE
  XLONG .type
  XLONG .window
  SBYTE .send_event
END TYPE

PACKED GDKEVENTVISIBILITY
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .state
END PACKED

PACKED GDKEVENTMOTION
  XLONG .type
  XLONG .window
  SBYTE .send_event
  ULONG .time
  DOUBLE .x
  DOUBLE .y
  XLONG .axes
  ULONG .state
  SSHORT .is_hint
  XLONG .device
  DOUBLE .x_root
	DOUBLE .y_root
END PACKED

TYPE GDKEVENTBUTTON
  XLONG .type
  XLONG .window
  SBYTE .send_event
  ULONG .time
  DOUBLE .x
  DOUBLE .y
  XLONG .axes
  ULONG .state
  ULONG .button
  XLONG .device
  DOUBLE .x_root
	DOUBLE .y_root
END TYPE

TYPE GDKEVENTSCROLL
  XLONG .type
  XLONG .window
  SBYTE .send_event
  ULONG .time
  DOUBLE .x
  DOUBLE .y
  ULONG .state
  XLONG .direction
  XLONG .device
  DOUBLE .x_root
	DOUBLE .y_root
END TYPE

PACKED GDKEVENTKEY
  XLONG .type
  XLONG .window
  SBYTE .send_event
  ULONG .time
  ULONG .state
  ULONG .keyval
  XLONG .length
  UBYTE .string
  USHORT .hardware_keycode
  UBYTE .group
  ULONG .is_modifier
END PACKED

TYPE GDKEVENTCROSSING
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .subwindow
  ULONG .time
  DOUBLE .x
  DOUBLE .y
  DOUBLE .x_root
  DOUBLE .y_root
  XLONG .mode
  XLONG .detail
  XLONG .focus
  ULONG .state
END TYPE

TYPE GDKEVENTFOCUS
  XLONG .type
  XLONG .window
  SBYTE .send_event
  SSHORT .in
END TYPE

TYPE GDKEVENTCONFIGURE
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .x
	XLONG .y
  XLONG .width
  XLONG .height
END TYPE

TYPE GDKEVENTPROPERTY
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .atom
  ULONG .time
  ULONG .state
END TYPE

TYPE GDKEVENTSELECTION
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .selection
  XLONG .target
  XLONG .property
  ULONG .time
  XLONG .equestor
END TYPE

TYPE GDKEVENTOWNERCHANGE
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .owner
  XLONG .reason
  XLONG .selection
  ULONG .time
  ULONG .selection_time
END TYPE

'/* This event type will be used pretty rarely. It only is important
'   for XInput aware programs that are drawing their own cursor */

TYPE GDKEVENTPROXIMITY
  XLONG .type
  XLONG .window
  SBYTE .send_event
  ULONG .time
  XLONG .device
END TYPE

TYPE GDKEVENTCLIENT
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .message_type
  USHORT .data_format
  UNION
    SBYTE .b[20]
    SSHORT .s[10]
    XLONG .l[5]
  END UNION
END TYPE

TYPE GDKEVENTSETTING
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .action
  XLONG .name
END TYPE

TYPE GDKEVENTWINDOWSTATE
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .changed_mask
  XLONG .new_window_state
END TYPE

TYPE GDKEVENTGRABBROKEN
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .keyboard
  XLONG .implicit
  XLONG .grab_window
END TYPE

'/* Event types for DND */

TYPE GDKEVENTDND
  XLONG .type
  XLONG .window
  SBYTE .send_event
  XLONG .context
  ULONG .time
  SSHORT .x_root
	SSHORT .y_root
END TYPE

