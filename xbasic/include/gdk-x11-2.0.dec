EXTERNAL CFUNCTION XLONG gdk_pango_context_get            ()
EXTERNAL CFUNCTION gdk_pango_context_set_colormap   (XLONG, XLONG)
'/* Get a clip region to draw only part of a layout or
' * line. index_ranges contains alternating range starts/stops. The
' * region is the region which contains the given ranges, i.e. if you
' * draw with the region as clip, only the given ranges are drawn.
EXTERNAL CFUNCTION XLONG gdk_pango_layout_line_get_clip_region (XLONG, XLONG, XLONG, XLONG, XLONG)
EXTERNAL CFUNCTION XLONG gdk_pango_layout_get_clip_region      (XLONG, XLONG, XLONG, XLONG, XLONG)
'/* Attributes use to render insensitive text in GTK+. */

TYPE GDKPANGOATTRSTIPPLE
  XLONG .attr
  XLONG .stipple
END TYPE

TYPE GDKPANGOATTREMBOSSED
