' GdkDragAction;

$$GDK_DRAG_PROTO_MOTIF = 0
$$GDK_DRAG_PROTO_XDND = 1
$$GDK_DRAG_PROTO_ROOTWIN	= 2  '/* A root window with nobody claiming drags */
