' GdkDragProtocol;

'/* Object that holds information about a drag in progress.
' * this is used on both source and destination sides.

TYPE GDKDRAGCONTEXT
  GOBJECT .parent_instance
'  /*< public >*/
  XLONG .protocol
  XLONG .is_source
  XLONG .source_window
  XLONG .dest_window
  XLONG .targets
  XLONG .actions
  XLONG .suggested_action
  XLONG .action
  ULONG .start_time
'  /*< private >*/
  XLONG .windowing_data
END TYPE

