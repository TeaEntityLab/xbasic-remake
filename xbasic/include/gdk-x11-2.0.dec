'########  gdkdisplay
'#########################

TYPE GDKDISPLAY
  GOBJECT .parent_instance
'  /*< private >*/
  XLONG .queued_events
  XLONG .queued_tail
'  /* Information for determining if the latest button click
'   * is part of a double-click or triple-click
  ULONG .button_click_time[2]	'/* The last 2 button click times. */
  XLONG .button_window[2]  '/* The last 2 windows to receive button presses. */
  XLONG .button_number[2]        '/* The last 2 buttons to be pressed. */
  ULONG .double_click_time	'/* Maximum time between clicks in msecs */
  XLONG .core_pointer	'/* Core pointer device */
  XLONG .pointer_hooks '/* Current hooks for querying pointer */
  ULONG .closed ': 1;		/* Whether this display has been closed */
  ULONG .double_click_distance	'/* Maximum distance between clicks in pixels */
  SLONG .button_x[2]             '/* The last 2 button click positions. */
  SLONG .button_y[2]
END TYPE

