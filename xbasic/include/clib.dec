'
' closesocket() is close() in UNIX - already in clib.dec
' ioctlsocket() is ioctl() in UNIX - already in clib.dec
' select() - already in clib.dec
' UTIMEVAL - already in clib.dec
'
' UNIX sockets funtions - noticed differences from Windows are noted above
'
' *******************************************
' *****  sockets function declarations  *****
' *******************************************
'
EXTERNAL CFUNCTION  accept           (socket, addrSOCKADDR, addrLength)
EXTERNAL CFUNCTION  bind             (socket, addrSOCKADDR, length)
' EXTERNAL CFUNCTION  closesocket      (socket)
EXTERNAL CFUNCTION  connect          (socket, addrSOCKADDR, length)
EXTERNAL CFUNCTION  getpeername      (socket, addrSOCKADDR, addrLength)
EXTERNAL CFUNCTION  getsockname      (socket, addrSOCKADDR, addrLength)
EXTERNAL CFUNCTION  getsockopt       (socket, level, optname, addrValue, addrLength)
EXTERNAL CFUNCTION  htonl            (hostlong)
EXTERNAL CFUNCTION  htons            (hostshort)
EXTERNAL CFUNCTION  inet_addr        (addrSTRING)
EXTERNAL CFUNCTION  inet_ntoa        (in_addr)
' EXTERNAL CFUNCTION  ioctlsocket      (socket, command, addrArg)
EXTERNAL CFUNCTION  listen           (socket, backlog)
EXTERNAL CFUNCTION  ntohl            (netlong)
EXTERNAL CFUNCTION  ntohs            (netshort)
EXTERNAL CFUNCTION  recv             (socket, addrBuffer, length, flags)
EXTERNAL CFUNCTION  recvfrom         (socket, addrBuffer, length, flags, addrSOCKADDR, addrLength)
' EXTERNAL CFUNCTION  select           (numfd, addrFD_SET, addrFD_SET, addrFD_SET, addrUTIMEVAL)
EXTERNAL CFUNCTION  send             (socket, addrMessage, length, flags)
EXTERNAL CFUNCTION  sendto           (socket, addrMessage, length, flags, addrSOCKADDR, tolength)
EXTERNAL CFUNCTION  setsockopt       (socket, level, optname, addrValue, optlen)
EXTERNAL CFUNCTION  shutdown         (socket, how)
EXTERNAL CFUNCTION  socket           (domain, type, protocol)
'
' "database" funtions
'
