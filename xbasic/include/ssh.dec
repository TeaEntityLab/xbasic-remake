'
' PROGRAM  "ssh"
' VERSION  "0.00"
'
'
' **************************************************
' *****  libssh library function declarations  *****
' **************************************************
'
EXTERNAL CFUNCTION ssh_connect                    (session)
EXTERNAL CFUNCTION ssh_disconnect                 (session)
EXTERNAL CFUNCTION ssh_finalize                   ()
EXTERNAL CFUNCTION ssh_free                       (session)
EXTERNAL CFUNCTION ssh_get_error_code             (session)
EXTERNAL CFUNCTION ssh_get_error                  (session)
EXTERNAL CFUNCTION ssh_get_pubkey_hash            (session, addr_string)
EXTERNAL CFUNCTION ssh_init                       ()
EXTERNAL CFUNCTION ssh_is_server_known            (session)
EXTERNAL CFUNCTION ssh_new                        ()
EXTERNAL CFUNCTION ssh_options_set                (session, opt_num, addr_string)
EXTERNAL CFUNCTION ssh_options_get                (session, opt_num, addr_string)
EXTERNAL CFUNCTION ssh_options_getopt             (session, addr_count, addr_string)
EXTERNAL CFUNCTION ssh_set_blocking               (session, blocking)
EXTERNAL CFUNCTION ssh_userauth_password          (session, addr_user, addr_pw)
'
' *****  channel functions  *****
'
EXTERNAL CFUNCTION ssh_channel_change_pty_size    (channel, lines, characters)
EXTERNAL CFUNCTION ssh_channel_close              (channel)
EXTERNAL CFUNCTION ssh_channel_free               (channel)
EXTERNAL CFUNCTION ssh_channel_is_eof             (channel)
EXTERNAL CFUNCTION ssh_channel_is_open            (channel)
EXTERNAL CFUNCTION ssh_channel_new                (session)
EXTERNAL CFUNCTION ssh_channel_open_session       (channel)
EXTERNAL CFUNCTION ssh_channel_read               (channel, addrBuff, buffSize, stderr)
EXTERNAL CFUNCTION ssh_channel_read_nonblocking   (channel, addrBuff, buffSize, stderr)
EXTERNAL CFUNCTION ssh_channel_request_pty        (channel)
EXTERNAL CFUNCTION ssh_channel_request_shell      (channel)
EXTERNAL CFUNCTION ssh_channel_send_eof           (channel)
EXTERNAL CFUNCTION ssh_channel_write              (channel, addrBuff, nbytes)
