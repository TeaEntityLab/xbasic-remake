$$GDK_INTERP_HYPER = 3
'} GdkInterpType;

$$GDK_PIXBUF_ROTATE_NONE             =   0
$$GDK_PIXBUF_ROTATE_COUNTERCLOCKWISE =  90
$$GDK_PIXBUF_ROTATE_UPSIDEDOWN       = 180
$$GDK_PIXBUF_ROTATE_CLOCKWISE        = 270
'} GdkPixbufRotation;

