	/usr/lib/X11/fonts/75dpi           Fixed- and variable-width fonts, 75 dots per inch
	/usr/lib/X11/fonts/100dpi          Fixed- and variable-width fonts, 100 dots per inch

	/etc/X11/fonts/...

