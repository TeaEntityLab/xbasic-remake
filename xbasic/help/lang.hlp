xma        These functions all require IMPORT "xma"
	         Angle values are always in radians  (degrees# * $$DEGTORAD)
	         The symbol suffix for DOUBLE is #
	
	See: radians
	
	DOUBLE = ACOS (DOUBLE x)     ' arc-cosine
	
	DOUBLE = ACOSH (DOUBLE x)    ' arc-hyperbolic-cosine
	
	DOUBLE = ATAN (DOUBLE x)     ' arc-tangent
	
	DOUBLE = ATANH (DOUBLE x)    ' arc-hyperbolic-tangent
	
	DOUBLE = ACSC (DOUBLE x)     ' arc-cosecant
	
	DOUBLE = ACSCH (DOUBLE x)    ' arc-hyperbolic-cosecant
	
	DOUBLE = ASEC (DOUBLE x)     ' arc-secant
	
	DOUBLE = ASECH (DOUBLE x)    ' arc-hyperbolic-secant
	
	DOUBLE = ASIN (DOUBLE x)     ' arc-sine
	
	DOUBLE = ASINH (DOUBLE x)    ' arc-hyperbolic-sine
	
	DOUBLE = ATAN (DOUBLE x)     ' arc-tangent
	
	DOUBLE = ATANH (DOUBLE x)    ' arc-hyperbolic-tangent
	
	DOUBLE = COS (DOUBLE x)      ' cosine
	
	DOUBLE = COSH (DOUBLE x)     ' hyperbolic-cosine
	
	DOUBLE = COT (DOUBLE x)      ' cotangent
	
	DOUBLE = COTH (DOUBLE x)     ' hyperbolic-cotangent
	
	DOUBLE = CSC (DOUBLE x)      ' cosecant
	
	DOUBLE = CSCH (DOUBLE x)     ' hyperbolic-cosecant
	
	DOUBLE = SEC (DOUBLE x)      ' secant
	
	DOUBLE = SECH (DOUBLE x)     ' hyperbolic-secant
	
	DOUBLE = SIN (DOUBLE x)      ' sine
	
	DOUBLE = SINH (DOUBLE x)     ' hyperbolic-sine
	
	DOUBLE = TAN (DOUBLE x)      ' tangent
	
	DOUBLE = TANH (DOUBLE x)     ' hyperbolic-tangent
	
:EXP()
:EXP10()
:LOG()
