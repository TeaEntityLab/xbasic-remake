#####################
xma        These functions all require IMPORT "xma"
	         The symbol suffix for DOUBLE is #
	
	DOUBLE = EXP (DOUBLE x)                ' exponential - e to the x power
	
	DOUBLE = EXP10 (DOUBLE x)              ' exponential - 10 to the x power
	
	DOUBLE = LOG (DOUBLE x)                ' logarithm - base e
	
	DOUBLE = LOG10 (DOUBLE x)              ' logarithm - base 10
	
	DOUBLE = POWER (DOUBLE x, DOUBLE y)    ' Raise x to y power - same as x ** y
	
	DOUBLE = SQRT (DOUBLE x)               ' square-root
	
	
	
	
