:XuiScrollBarH()
##############################
#####  XuiScrollBarH ()  #####
##############################

	XuiScrollBarH (@grid, #Create, x, y, width, height, window, parent)

	Style = 0		- size 12 pixels, normal scroll bar,        flat buttons
	Style = 1		- size 12 pixels, normal scroll bar,        flat arrowbuttons
	Style = 2		- size 16 pixels, recessed scroll bar,      arrow buttons
	Style = 3		- size 16 pixels, windows-style scroll bar, arrow buttons
	Style = 4   - size 20 pixels, same as style 2
	Style = 5   - size 20 pixels, same as style 3
	Style = 6   - size 24 pixels, same as style 4
	Style = 7   - size 24 pixels, same as style 5

FUNCTION  XuiScrollBarH (grid, message, v0, v1, v2, v3, r0, (r1, r1$, r1[], r1$[]))
